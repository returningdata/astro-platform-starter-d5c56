---
/** Labelled select. */
interface Props {
    label: string;
    name: string;
    options: readonly string[];
    required?: boolean;
    full?: boolean;
    value?: string;
}

const { label, name, options, required = false, full = false, value } = Astro.props;
const id = `kl-field-${name}`;
---

<div class={`kl-field ${full ? 'kl-field--full' : ''}`}>
    <label class="kl-label" for={id}>{label}{required && <span aria-hidden="true"> *</span>}</label>
    <select class="kl-select" id={id} name={name} required={required}>
        {options.map((option) => <option value={option} selected={option === value}>{option}</option>)}
    </select>
</div>
