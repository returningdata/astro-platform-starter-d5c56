---
import type { HTMLAttributes } from 'astro/types';

/** Labelled text input, or a textarea when `textarea` is set. */
interface Props extends Omit<HTMLAttributes<'input'>, 'type'> {
    label: string;
    name: string;
    type?: HTMLAttributes<'input'>['type'];
    hint?: string;
    full?: boolean;
    textarea?: boolean;
}

const {
    label,
    name,
    type = 'text',
    required = false,
    hint,
    full = false,
    textarea = false,
    ...rest
} = Astro.props;

const id = `kl-field-${name}`;
---

<div class={`kl-field ${full ? 'kl-field--full' : ''}`}>
    <label class="kl-label" for={id}>{label}{required && <span aria-hidden="true"> *</span>}</label>
    {
        textarea ? (
            <textarea class="kl-textarea" id={id} name={name} required={required} {...rest} />
        ) : (
            <input class="kl-input" id={id} name={name} type={type} required={required} {...rest} />
        )
    }
    {hint && <span class="kl-hint">{hint}</span>}
</div>
