---
/**
 * Kruiger Labs wordmark: brushed-silver "KRUIGER" with a violet "LABS",
 * paired with the KL monogram mark.
 */
interface Props {
    /** Rendered size of the monogram in pixels. */
    mark?: number;
    /** Font size for the wordmark text. */
    size?: string;
    /** Hide the text and show only the monogram. */
    markOnly?: boolean;
    class?: string;
    stacked?: boolean;
}

const { mark = 30, size = '1.05rem', markOnly = false, class: className = '', stacked = false } = Astro.props;
---

<span class={`kl-wordmark ${stacked ? 'kl-wordmark--stacked' : ''} ${className}`} style={`--kl-mark:${mark}px;--kl-wm-size:${size}`}>
    <svg class="kl-wordmark__mark" viewBox="0 0 48 48" role="img" aria-label="Kruiger Labs monogram" focusable="false">
        <defs>
            <linearGradient id="klChrome" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#ffffff"></stop>
                <stop offset="38%" stop-color="#d7d9df"></stop>
                <stop offset="62%" stop-color="#8f919a"></stop>
                <stop offset="100%" stop-color="#f1f1f3"></stop>
            </linearGradient>
            <linearGradient id="klViolet" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#c084fc"></stop>
                <stop offset="55%" stop-color="#a855f7"></stop>
                <stop offset="100%" stop-color="#6d28d9"></stop>
            </linearGradient>
        </defs>
        <!-- Outer ring, broken to echo the swoosh in the brand mark -->
        <path
            d="M24 3.5A20.5 20.5 0 1 0 44.5 24"
            fill="none"
            stroke="url(#klChrome)"
            stroke-width="2.6"
            stroke-linecap="round"></path>
        <path d="M44.5 24A20.5 20.5 0 0 1 24 44.5" fill="none" stroke="url(#klViolet)" stroke-width="2.6" stroke-linecap="round"></path>
        <!-- K -->
        <path d="M13 13.5V34.5" fill="none" stroke="url(#klChrome)" stroke-width="3.4" stroke-linecap="round"></path>
        <path d="M23.5 13.5 13.6 24l9.9 10.5" fill="none" stroke="url(#klChrome)" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"></path>
        <!-- L -->
        <path d="M28.5 13.5V34.5h7.5" fill="none" stroke="url(#klViolet)" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    {
        !markOnly && (
            <span class="kl-wordmark__text">
                <span class="kl-metal">Kruiger</span>
                <span class="kl-violet">Labs</span>
            </span>
        )
    }
</span>

<style>
    .kl-wordmark {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        line-height: 1;
    }

    .kl-wordmark__mark {
        width: var(--kl-mark);
        height: var(--kl-mark);
        flex: none;
        filter: drop-shadow(0 0 8px rgba(139, 92, 246, 0.35));
    }

    .kl-wordmark__text {
        display: inline-flex;
        gap: 0.34em;
        font-family: var(--kl-font-display);
        font-size: var(--kl-wm-size);
        font-weight: 800;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .kl-wordmark--stacked .kl-wordmark__text {
        flex-direction: column;
        gap: 0.1em;
        line-height: 1.05;
    }
</style>
