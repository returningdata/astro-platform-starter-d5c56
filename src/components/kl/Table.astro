---
/** Horizontally scrollable data table wrapper. */
interface Props {
    columns: readonly string[];
    caption?: string;
    class?: string;
}

const { columns, caption, class: className = '' } = Astro.props;
---

<div class={`kl-table-wrap ${className}`.trim()}>
    <table class="kl-table">
        {caption && <caption class="kl-visually-hidden">{caption}</caption>}
        <thead>
            <tr>{columns.map((column) => <th scope="col">{column}</th>)}</tr>
        </thead>
        <tbody>
            <slot />
        </tbody>
    </table>
</div>
