    zap: '<polygon points="13 2 4 14 11 14 10 22 20 10 13 10 13 2"/>',
    book: '<path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v18H6.5A2.5 2.5 0 0 0 4 22z"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="14" y2="11"/>',
    mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="3 6.5 12 13 21 6.5"/>',
    arrow: '<line x1="4" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/>',
