---
/**
 * Clean line-style technical icon set.
 * Single stroke weight, no fills, no cartoon shapes.
 */
interface Props {
    name: string;
    class?: string;
    size?: number | string;
}

const { name, class: className = '', size = 24 } = Astro.props;

