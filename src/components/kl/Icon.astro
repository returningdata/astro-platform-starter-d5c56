    shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>',
    globe: '<circle cx="12" cy="12" r="9"/><line x1="3" y1="12" x2="21" y2="12"/><path d="M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18z"/>',
    cpu: '<rect x="6" y="6" width="12" height="12" rx="2"/><rect x="9.5" y="9.5" width="5" height="5" rx="1"/><path d="M9 2v3M15 2v3M9 19v3M15 19v3M2 9h3M2 15h3M19 9h3M19 15h3"/>',
    discord: '<path d="M8.5 4.5A15 15 0 0 0 4.8 6C2.6 9.4 2 12.6 2.3 15.8a15 15 0 0 0 4.5 2.3l.9-1.5"/><path d="M15.5 4.5A15 15 0 0 1 19.2 6c2.2 3.4 2.8 6.6 2.5 9.8a15 15 0 0 1-4.5 2.3l-.9-1.5"/><path d="M7.3 16.6a12 12 0 0 0 9.4 0"/><ellipse cx="9" cy="12" rx="1.4" ry="1.8"/><ellipse cx="15" cy="12" rx="1.4" ry="1.8"/>',
    gamepad: '<path d="M6 11h4M8 9v4"/><circle cx="16" cy="11" r="0.6"/><circle cx="18" cy="13.5" r="0.6"/><path d="M17.5 6h-11a4.5 4.5 0 0 0-4.4 3.6l-1 5A3.6 3.6 0 0 0 4.6 19c1.2 0 2.3-.6 3-1.6L9 15.5h6l1.4 1.9c.7 1 1.8 1.6 3 1.6a3.6 3.6 0 0 0 3.5-4.4l-1-5A4.5 4.5 0 0 0 17.5 6z"/>',
    users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
    layers: '<polygon points="12 2 22 8 12 14 2 8 12 2"/><polyline points="2 13 12 19 22 13"/>',
    lifebuoy: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.6"/><line x1="5.6" y1="5.6" x2="9.5" y2="9.5"/><line x1="14.5" y1="14.5" x2="18.4" y2="18.4"/><line x1="18.4" y1="5.6" x2="14.5" y2="9.5"/><line x1="9.5" y1="14.5" x2="5.6" y2="18.4"/>',
