---
/**
 * Decorative background layer for hero and CTA bands.
 * Purely presentational — hidden from assistive technology.
 */
interface Props {
    /** Adds a horizontal purple light beam behind the content. */
    beam?: boolean;
    /** Renders two slow-drifting glow orbs. */
    orbs?: boolean;
    /** Renders a lightweight particle canvas (auto-disabled for reduced motion). */
    particles?: boolean;
    class?: string;
}

const { beam = false, orbs = false, particles = false, class: className = '' } = Astro.props;
---

<div class={`kl-bg-grid ${className}`} aria-hidden="true">
    {orbs && <span class="kl-orb kl-orb--a" />}
    {orbs && <span class="kl-orb kl-orb--b" />}
    {beam && <span class="kl-beam" />}
    {particles && <canvas class="kl-particles" data-kl-particles></canvas>}
</div>

<style>
    .kl-bg-grid {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 0;
    }

    .kl-orb--a {
        width: min(46vw, 520px);
        height: min(46vw, 520px);
        left: -8%;
        top: -14%;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.42), transparent 70%);
    }

    .kl-orb--b {
        width: min(38vw, 440px);
        height: min(38vw, 440px);
        right: -6%;
        bottom: -18%;
        background: radial-gradient(circle, rgba(109, 40, 217, 0.34), transparent 70%);
        animation-delay: -8s;
    }

    /* Horizontal neon light bar, echoing the brand banner. */
    .kl-beam {
        position: absolute;
        left: 50%;
        top: 50%;
        width: min(1100px, 92%);
        height: 2px;
        transform: translate(-50%, -50%);
        background: linear-gradient(90deg, transparent, rgba(168, 85, 247, 0.15) 18%, #c084fc 50%, rgba(168, 85, 247, 0.15) 82%, transparent);
        box-shadow: 0 0 26px 3px rgba(139, 92, 246, 0.45);
        opacity: 0.75;
    }

    .kl-particles {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0.55;
    }

    @media (prefers-reduced-motion: reduce) {
        .kl-particles {
            display: none;
        }
    }
</style>
