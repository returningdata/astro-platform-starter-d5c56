---
/**
 * Footer for the Netlify platform demo routes. Points back at the main site
 * rather than dead-ending on the starter template link.
 */
const year = new Date().getFullYear();
---

<footer class="pt-16 pb-12 text-sm sm:pt-24 sm:pb-16">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-[#a1a1aa]">
        <a href="/" class="no-underline transition-colors hover:text-white">Home</a>
        <a href="/products" class="no-underline transition-colors hover:text-white">Products</a>
        <a href="/docs" class="no-underline transition-colors hover:text-white">Documentation</a>
        <a href="/support" class="no-underline transition-colors hover:text-white">Support</a>
        <a href="https://docs.netlify.com/frameworks/astro/" class="decoration-dashed text-primary underline-offset-8">
            Astro on Netlify
        </a>
    </div>
    <p class="mt-4 text-[#8f919a]">&copy; {year} Kruiger Labs LLC. All rights reserved.</p>
</footer>
