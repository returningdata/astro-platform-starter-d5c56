---
import KruigerLayout from '../layouts/KruigerLayout.astro';

const nordVpnLink = 'https://go.nordvpn.net/aff_c?offer_id=15&aff_id=152990&url_id=902';
const nordPassLink = 'https://go.nordpass.io/aff_c?offer_id=488&aff_id=152990&url_id=9356';
---

<KruigerLayout
  title="Online Security Toolkit | KruigerLabs"
  description="Learn how NordVPN and NordPass can help protect your internet connection, passwords, and everyday online accounts."
>
  <main class="security-page">
    <header class="security-nav" aria-label="Primary navigation">
      <a class="security-brand" href="/" aria-label="KruigerLabs home">
        KRUIGER<span>LABS</span>
      </a>
      <nav aria-label="Security page navigation">
        <a href="#why-vpn">Why a VPN</a>
        <a href="#passwords">Password Security</a>
        <a href="#faq">FAQ</a>
      </nav>
      <a class="nav-cta" href={nordVpnLink} target="_blank" rel="sponsored noopener noreferrer">
        Explore NordVPN
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </header>

    <section class="security-hero">
      <div class="hero-copy">
        <div class="eyebrow"><span></span>KruigerLabs member security guide</div>
        <h1>Your online life needs <em>two</em> strong locks.</h1>
        <p class="hero-lede">
          A VPN protects the connection you use. A password manager protects the accounts you access.
          Together, NordVPN and NordPass create a practical security layer for gaming, work, travel, and everyday browsing.
        </p>
        <div class="hero-actions">
          <a class="primary-action" href={nordVpnLink} target="_blank" rel="sponsored noopener noreferrer">
            Get NordVPN
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a class="secondary-action" href={nordPassLink} target="_blank" rel="sponsored noopener noreferrer">
            Explore NordPass
          </a>
        </div>
        <p class="affiliate-note">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          Affiliate disclosure: KruigerLabs may earn a commission if you purchase through these links, at no added cost to you.
        </p>
      </div>

      <div class="security-visual" aria-label="Illustration of protected online activity">
        <div class="orbit orbit-one"></div>
        <div class="orbit orbit-two"></div>
        <div class="signal-card signal-card-top">
          <span class="signal-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><path d="M12 20h.01"/></svg>
          </span>
          <span><b>Public Wi-Fi</b><small>Encrypted connection</small></span>
        </div>
        <div class="signal-card signal-card-bottom">
          <span class="signal-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </span>
          <span><b>Account access</b><small>Unique credentials</small></span>
        </div>
        <div class="shield-core">
          <svg viewBox="0 0 120 140" aria-hidden="true">
            <path d="M60 5 108 23v39c0 35-20 60-48 73C32 122 12 97 12 62V23L60 5Z"/>
            <path d="M42 69 55 82l25-30"/>
          </svg>
          <strong>Protected</strong>
          <span>Connection + accounts</span>
        </div>
        <div class="status-pill"><i></i>Security stack active</div>
      </div>
    </section>

    <section class="trust-strip" aria-label="Recommended use cases">
      <span>Built for real online habits</span>
      <div><i></i>Remote work</div>
      <div><i></i>Travel</div>
      <div><i></i>Gaming communities</div>
      <div><i></i>Everyday browsing</div>
    </section>

    <section class="briefing-section" id="why-vpn">
      <div class="section-heading">
        <p>01 / Connection security</p>
        <h2>Why KruigerLabs members should use a VPN</h2>
      </div>

      <div class="vpn-layout">
        <article class="feature-lead">
          <span class="feature-number">01</span>
          <div class="feature-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h3>Protect traffic on networks you do not control</h3>
          <p>
            Airports, hotels, cafés, convention centers, and shared housing networks can be convenient without being trustworthy.
            NordVPN encrypts traffic between your device and its VPN server, reducing what people on the same local network can observe.
          </p>
          <div class="use-case"><span>Best for</span> Travel, remote work, and public Wi-Fi</div>
        </article>

        <div class="feature-stack">
          <article>
            <span class="feature-number">02</span>
            <h3>Reduce casual tracking tied to your IP address</h3>
            <p>A VPN replaces the public IP address websites see with the address of the VPN server. It is a useful privacy layer alongside secure browsers, careful permissions, and tracker controls.</p>
          </article>
          <article>
            <span class="feature-number">03</span>
            <h3>Secure everyday activity without changing your routine</h3>
            <p>Once configured, NordVPN can automatically connect on untrusted networks. Apps are available across common desktop, mobile, browser, TV, and router environments.</p>
          </article>
          <article>
            <span class="feature-number">04</span>
            <h3>Add specialized tools when you need them</h3>
            <p>Depending on plan and platform, NordVPN includes options such as Threat Protection, a kill switch, Double VPN, Meshnet, and dark web monitoring.</p>
          </article>
        </div>
      </div>

      <aside class="reality-check">
        <div>
          <span class="label">Important reality check</span>
          <h3>A VPN is a strong layer, not an invisibility cloak.</h3>
        </div>
        <p>
          Stay cautious with downloads, phishing links, browser permissions, and personal information. Keep devices updated and use multi-factor authentication wherever possible.
        </p>
      </aside>
    </section>

    <section class="pass-section" id="passwords">
      <div class="pass-intro">
        <p class="section-kicker">02 / Account security</p>
        <h2>NordPass closes the gap a VPN cannot.</h2>
        <p>
          A VPN protects data in transit, but it cannot fix a reused password or stop someone from signing in with stolen credentials.
          NordPass helps members create, store, and use stronger account credentials without relying on memory.
        </p>
        <a class="text-link" href={nordPassLink} target="_blank" rel="sponsored noopener noreferrer">
          View NordPass options
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      <div class="pass-grid">
        <article class="pass-card pass-card-wide">
          <div class="pass-card-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="7.5" cy="15.5" r="5.5"/><path d="m11.5 11.5 9-9M17 6l3 3M14 9l3 3"/></svg>
          </div>
          <h3>One unique password for every account</h3>
          <p>Password reuse turns one breach into a chain reaction. A password manager generates and remembers long, unique credentials so one exposed service does not automatically compromise the rest.</p>
          <div class="password-demo" aria-label="Example of a generated password">
            <span>Generated password</span>
            <code>••••••••••••••••••••</code>
            <i>Strong</i>
          </div>
        </article>

        <article class="pass-card">
          <div class="pass-card-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 9h6M7 13h10M7 17h4"/></svg>
          </div>
          <h3>Faster, safer sign-ins</h3>
          <p>Autofill reduces typing and helps you avoid weak variations of the same familiar password across Discord, gaming, email, shopping, and work accounts.</p>
        </article>

        <article class="pass-card">
          <div class="pass-card-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.6 2.9 16.5A2 2 0 0 0 4.6 19.5h14.8a2 2 0 0 0 1.7-3L13.7 3.6a2 2 0 0 0-3.4 0Z"/></svg>
          </div>
          <h3>Spot weak or exposed credentials</h3>
          <p>Password health and breach-monitoring tools can help identify credentials that need attention, so you can prioritize changes instead of guessing.</p>
        </article>

        <article class="pass-card pass-card-accent">
          <span class="mini-label">Modern login support</span>
          <h3>Store passkeys alongside passwords</h3>
          <p>As more services adopt passkeys, NordPass can keep supported credentials organized and available across your devices.</p>
        </article>
      </div>
    </section>

    <section class="stack-section">
      <div class="section-heading compact">
        <p>03 / Recommended setup</p>
        <h2>A practical security stack in four moves</h2>
      </div>
      <ol class="steps-list">
        <li>
          <span>01</span>
          <div><h3>Install NordVPN</h3><p>Add it to the devices you use outside your home and enable automatic protection for untrusted networks.</p></div>
        </li>
        <li>
          <span>02</span>
          <div><h3>Move passwords into NordPass</h3><p>Import existing credentials, then replace reused or weak passwords with unique generated ones.</p></div>
        </li>
        <li>
          <span>03</span>
          <div><h3>Turn on multi-factor authentication</h3><p>Start with email, Discord, finance, cloud storage, and any account that can reset other accounts.</p></div>
        </li>
        <li>
          <span>04</span>
          <div><h3>Review alerts and updates</h3><p>Act on breach notifications, keep apps current, and remove devices or sessions you no longer recognize.</p></div>
        </li>
      </ol>
    </section>

    <section class="faq-section" id="faq">
      <div class="section-heading compact">
        <p>04 / Quick answers</p>
        <h2>Before you choose</h2>
      </div>
      <div class="faq-list">
        <details open>
          <summary>Do I need both NordVPN and NordPass?<span></span></summary>
          <p>They solve different problems. NordVPN protects your internet connection; NordPass protects the credentials used to enter your accounts. Using both creates broader coverage than either tool alone.</p>
        </details>
        <details>
          <summary>Does a VPN make me completely anonymous?<span></span></summary>
          <p>No. A VPN improves connection privacy, but websites can still identify you through logins, cookies, browser fingerprinting, and information you share. Treat it as one part of a layered security approach.</p>
        </details>
        <details>
          <summary>Will NordVPN work on every device?<span></span></summary>
          <p>NordVPN supports many popular platforms, but features can differ by operating system, app version, region, and subscription. Review current compatibility on the offer page before purchasing.</p>
        </details>
        <details>
          <summary>Why use a password manager instead of browser storage?<span></span></summary>
          <p>A dedicated password manager is designed around credential generation, organization, cross-device access, password health, and secure sharing features. Choose the setup that fits your risk level and devices.</p>
        </details>
      </div>
    </section>

    <section class="final-cta">
      <div>
        <p>KruigerLabs security recommendation</p>
        <h2>Protect the connection. Lock down the accounts.</h2>
      </div>
      <div class="final-actions">
        <a class="primary-action" href={nordVpnLink} target="_blank" rel="sponsored noopener noreferrer">Get NordVPN</a>
        <a class="secondary-action" href={nordPassLink} target="_blank" rel="sponsored noopener noreferrer">Get NordPass</a>
      </div>
    </section>

    <footer class="security-footer">
      <a class="security-brand" href="/">KRUIGER<span>LABS</span></a>
      <p>Independent recommendations for a safer online community.</p>
      <p>NordVPN and NordPass are trademarks of their respective owners. Features and offers may change.</p>
    </footer>
  </main>
</KruigerLayout>

<style>
  :global(body) {
    background: #07110f;
  }

  :global(body::before) {
    display: none;
  }

  .security-page {
    --ink: #07110f;
    --paper: #f3f1e8;
    --paper-deep: #e8e5d8;
    --mint: #b8e4d3;
    --green: #79d6b3;
    --acid: #d9f28b;
    --line: rgba(7, 17, 15, 0.17);
    --muted: #5c6964;
    min-height: 100vh;
    background:
      linear-gradient(rgba(7,17,15,.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(7,17,15,.045) 1px, transparent 1px),
      var(--paper);
    background-size: 42px 42px;
    color: var(--ink);
    font-family: "Inter", sans-serif;
    position: relative;
  }

  .security-page :global(*) { box-sizing: border-box; }
  .security-page :global(a) { color: inherit; text-decoration: none; }

  .security-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    min-height: 76px;
    padding: 0 clamp(22px, 5vw, 76px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    border-bottom: 1px solid var(--line);
    background: rgba(243, 241, 232, 0.9);
    backdrop-filter: blur(18px);
  }

  .security-brand {
    width: fit-content;
    font-family: "Orbitron", sans-serif;
    font-size: 1.06rem;
    font-weight: 800;
    letter-spacing: .075em;
  }

  .security-brand span { color: #168b69; }

  .security-nav nav { display: flex; gap: 2rem; }
  .security-nav nav a {
    color: #33423d;
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .04em;
  }
  .security-nav nav a:hover { color: #087052; }

  .nav-cta {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    padding: .7rem 1rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper) !important;
    font-size: .76rem;
    font-weight: 800;
    letter-spacing: .025em;
    transition: transform .2s ease, background .2s ease;
  }
  .nav-cta:hover { transform: translateY(-2px); background: #17352d; }
  .nav-cta svg, .primary-action svg, .text-link svg { width: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; }

  .security-hero {
    min-height: 720px;
    padding: 86px clamp(24px, 7vw, 112px) 92px;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(380px, .95fr);
    gap: clamp(50px, 8vw, 132px);
    align-items: center;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .hero-copy { max-width: 730px; }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: .75rem;
    margin-bottom: 1.6rem;
    color: #2c4f43;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .eyebrow span { width: 34px; height: 2px; background: #178965; }

  .security-hero h1 {
    max-width: 760px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.5rem, 6.2vw, 7.4rem);
    font-weight: 400;
    line-height: .91;
    letter-spacing: -.065em;
  }
  .security-hero h1 em { color: #168b69; font-weight: 400; }
  .hero-lede {
    max-width: 680px;
    margin-top: 2rem;
    color: #45534e;
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    line-height: 1.75;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2.2rem; }
  .primary-action, .secondary-action {
    min-height: 52px;
    padding: .9rem 1.35rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .75rem;
    border: 1px solid var(--ink);
    font-size: .82rem;
    font-weight: 800;
    letter-spacing: .035em;
    transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
  }
  .primary-action { background: var(--ink); color: var(--paper) !important; box-shadow: 7px 7px 0 var(--green); }
  .secondary-action { background: transparent; }
  .primary-action:hover, .secondary-action:hover { transform: translate(-2px, -2px); }
  .primary-action:hover { box-shadow: 10px 10px 0 var(--green); }
  .secondary-action:hover { background: var(--paper-deep); }

  .affiliate-note {
    max-width: 590px;
    margin-top: 1.8rem;
    display: flex;
    gap: .65rem;
    color: #69746f;
    font-size: .72rem;
    line-height: 1.55;
  }
  .affiliate-note svg { flex: 0 0 16px; width: 16px; fill: none; stroke: #168b69; stroke-width: 1.7; }

  .security-visual {
    min-height: 500px;
    position: relative;
    display: grid;
    place-items: center;
  }
  .security-visual::before {
    content: "";
    position: absolute;
    width: min(430px, 85vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 0 34px rgba(184,228,211,.34), 0 0 0 68px rgba(184,228,211,.16);
  }
  .orbit { position: absolute; width: 460px; height: 210px; border: 1px solid rgba(7,17,15,.24); border-radius: 50%; z-index: 1; }
  .orbit-one { transform: rotate(28deg); }
  .orbit-two { transform: rotate(-28deg); }
  .orbit::after { content: ""; position: absolute; width: 9px; height: 9px; border-radius: 50%; background: var(--ink); top: 44px; left: 38px; }

  .shield-core {
    position: relative;
    z-index: 3;
    width: 230px;
    height: 280px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: var(--ink);
    color: var(--paper);
    clip-path: polygon(50% 0, 95% 17%, 95% 56%, 83% 77%, 50% 100%, 17% 77%, 5% 56%, 5% 17%);
    filter: drop-shadow(18px 22px 0 rgba(22,139,105,.27));
  }
  .shield-core svg { width: 92px; height: 108px; fill: none; stroke: var(--green); stroke-width: 5; stroke-linecap: square; stroke-linejoin: miter; }
  .shield-core strong { margin-top: .4rem; font-family: "Orbitron", sans-serif; font-size: 1rem; letter-spacing: .06em; }
  .shield-core span { margin-top: .4rem; color: #9fafa9; font-size: .68rem; }

  .signal-card {
    position: absolute;
    z-index: 4;
    min-width: 204px;
    padding: .85rem 1rem;
    display: flex;
    align-items: center;
    gap: .8rem;
    background: rgba(243,241,232,.95);
    border: 1px solid var(--ink);
    box-shadow: 7px 7px 0 rgba(7,17,15,.14);
  }
  .signal-card-top { top: 52px; right: -18px; }
  .signal-card-bottom { bottom: 78px; left: -25px; }
  .signal-icon { width: 36px; height: 36px; display: grid; place-items: center; background: var(--acid); }
  .signal-icon svg { width: 20px; fill: none; stroke: var(--ink); stroke-width: 1.8; stroke-linecap: round; }
  .signal-card b, .signal-card small { display: block; }
  .signal-card b { font-size: .76rem; }
  .signal-card small { margin-top: .2rem; color: var(--muted); font-size: .65rem; }
  .status-pill { position: absolute; z-index: 5; bottom: 25px; right: 17px; padding: .6rem .8rem; background: #fffdf3; border: 1px solid var(--line); font-size: .66rem; font-weight: 800; }
  .status-pill i { display: inline-block; width: 7px; height: 7px; margin-right: .45rem; border-radius: 50%; background: #168b69; box-shadow: 0 0 0 4px rgba(22,139,105,.14); }

  .trust-strip {
    padding: 20px clamp(24px, 7vw, 112px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: var(--ink);
    color: #aebbb6;
    font-size: .72rem;
    letter-spacing: .04em;
  }
  .trust-strip > span { color: var(--acid); font-weight: 800; text-transform: uppercase; }
  .trust-strip div { white-space: nowrap; }
  .trust-strip i { display: inline-block; width: 5px; height: 5px; margin-right: .55rem; border-radius: 50%; background: var(--green); vertical-align: middle; }

  .briefing-section, .pass-section, .stack-section, .faq-section {
    padding: 110px clamp(24px, 7vw, 112px);
    border-bottom: 1px solid var(--line);
  }
  .section-heading { max-width: 880px; margin-bottom: 4rem; }
  .section-heading p, .section-kicker {
    margin-bottom: 1rem;
    color: #168b69;
    font-size: .7rem;
    font-weight: 900;
    letter-spacing: .17em;
    text-transform: uppercase;
  }
  .section-heading h2, .pass-intro h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.6rem, 4.6vw, 5.4rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -.05em;
  }
  .section-heading.compact { max-width: 740px; }

  .vpn-layout { display: grid; grid-template-columns: 1.1fr .9fr; gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .feature-lead, .feature-stack article { background: var(--paper); }
  .feature-lead { min-height: 560px; padding: clamp(30px, 4.5vw, 68px); display: flex; flex-direction: column; }
  .feature-number { color: #71807a; font-family: "Orbitron", sans-serif; font-size: .64rem; letter-spacing: .08em; }
  .feature-icon, .pass-card-icon { width: 58px; height: 58px; margin: auto 0 2rem; display: grid; place-items: center; background: var(--mint); border: 1px solid var(--ink); }
  .feature-icon svg, .pass-card-icon svg { width: 28px; fill: none; stroke: var(--ink); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .feature-lead h3 { max-width: 570px; font-family: Georgia, serif; font-size: clamp(2rem, 3vw, 3.2rem); font-weight: 400; line-height: 1.08; letter-spacing: -.035em; }
  .feature-lead > p { max-width: 650px; margin-top: 1.4rem; color: var(--muted); line-height: 1.75; }
  .use-case { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--line); color: #30413b; font-size: .75rem; }
  .use-case span { margin-right: .7rem; color: #168b69; font-weight: 900; text-transform: uppercase; letter-spacing: .08em; }
  .feature-stack { display: grid; gap: 1px; background: var(--line); }
  .feature-stack article { padding: 34px clamp(28px, 3.5vw, 50px); }
  .feature-stack h3 { margin-top: 1rem; font-family: Georgia, serif; font-size: 1.55rem; font-weight: 400; line-height: 1.15; }
  .feature-stack p { margin-top: .8rem; color: var(--muted); font-size: .88rem; line-height: 1.65; }

  .reality-check { margin-top: 26px; padding: 32px 38px; display: grid; grid-template-columns: .9fr 1.1fr; gap: 3rem; align-items: center; background: var(--acid); border: 1px solid var(--ink); box-shadow: 9px 9px 0 var(--ink); }
  .reality-check .label { font-size: .65rem; font-weight: 900; letter-spacing: .13em; text-transform: uppercase; }
