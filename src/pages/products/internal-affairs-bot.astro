---
import ProductLayout from '../../layouts/ProductLayout.astro';
const highlights=['Case management','User and server investigations','Blacklist requests','Punishment requests','Evidence and case threads','First-stage reviews','High Command final reviews','Reviewer tracking','Administrative records','Detailed audit logs'];
---
<ProductLayout title="Internal Affairs Bot" description="Professional Discord investigation, case-management, blacklist, punishment-review, and administrative records."><div class="filterbar"><a class="badge" href="/products">Products</a><span>→</span><span class="badge">Discord Bots</span><span>→</span><span class="badge good">Internal Affairs Bot</span></div><section class="hero-panel"><div style="display:grid;grid-template-columns:auto 1fr;gap:28px;align-items:center;position:relative;z-index:1"><img src="/assets/internal-affairs/logo.png" alt="Internal Affairs Bot logo" style="width:130px;height:130px;object-fit:cover;border-radius:28px"/><div><div class="eyebrow">Professional Discord administration</div><h1 class="hero-title" style="font-size:clamp(2.7rem,6vw,5.6rem)">Internal Affairs Bot</h1><div class="badges"><span class="badge">Category: Discord Bot</span><span class="badge good">Available</span><span class="badge">Developer: Kruiger Labs LLC</span><span class="badge">Support available</span><span class="badge">Custom configuration</span></div></div></div><p class="lead">A professional Discord investigation, case-management, blacklist, punishment-review, and administrative-record system built for roleplay communities, departments, staff teams, and multi-server organisations.</p><div class="hero-actions"><a class="button" href="/docs/internal-affairs-bot">Read Documentation</a><a class="button-secondary" href="/docs/commands">Commands</a><a class="button-secondary" href="/docs/setup">Setup</a><a class="button-secondary" href="/docs/support?product=Internal%20Affairs%20Bot">Get Support</a><a class="button-secondary" href="/products/internal-affairs-bot/request-access">Request Access</a></div></section><section class="section"><h2>Professional Internal Affairs Management</h2><p class="lead">The Internal Affairs Bot gives communities and administrative teams a secure and organised way to manage investigations, cases, blacklists, punishments, evidence, staff records, and multi-stage approval workflows directly through Discord.</p><ul class="feature-list">{highlights.map(item=><li>{item}</li>)}</ul></section><section class="section"><div class="grid two"><article class="card"><h3>Standard review</h3><p>Authorised reviewers claim, approve, deny, or request more information. Every decision and reason is logged.</p></article><article class="card"><h3>High Command review</h3><p>Approved submissions move to a separate final-review stage where High Command and higher authorised roles complete the second review.</p></article><article class="card"><h3>Verified completion records</h3><p>The original request message updates with final status, submitter, first reviewer, final reviewer, dates, reason, and case number.</p></article><article class="card"><h3>Responsible server checks</h3><p>The bot only reports mutual servers where it is installed and authorised. Keyword matches are indicators for review, never automatic proof.</p></article></div></section><section class="section"><h2>Product navigation</h2><div class="hero-actions"><a class="button-secondary" href="/docs/internal-affairs-bot">Overview</a><a class="button-secondary" href="/docs/internal-affairs-bot#features">Features</a><a class="button-secondary" href="/docs">Documentation</a><a class="button-secondary" href="/docs/commands">Commands</a><a class="button-secondary" href="/docs/setup">Setup</a><a class="button-secondary" href="/docs/support">Support</a><a class="button-secondary" href="/docs/changelog">Changelog</a><a class="button-secondary" href="/docs/status">Service status</a></div></section></ProductLayout>

