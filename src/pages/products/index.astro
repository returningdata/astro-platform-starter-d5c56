---
import ProductLayout from '../../layouts/ProductLayout.astro';
import { products } from '../../data/portal';
---
<ProductLayout title="Products" description="Kruiger Labs LLC products, integrations, websites, hosting, automation, and custom development."><div class="eyebrow">Products and services</div><h1 class="hero-title">Built for communities that need systems they can trust.</h1><p class="lead">Browse Discord products, websites, dashboards, automation, integrations, hosting, and custom development. Internal Affairs Bot is currently the only listed Discord bot.</p><div class="filterbar"><span class="badge">Products</span><span>→</span><span class="badge">Discord Bots</span><span>→</span><span class="badge good">Internal Affairs Bot</span></div><div class="grid" style="margin-top:32px">{products.map(product=><article class="card product-card"><img class="product-logo" src={product.logo || '/logo.png'} alt=""/><div class="badges"><span class="badge good">{product.status}</span><span class="badge">{product.category}</span></div><h3>{product.name}</h3><p>{product.description}</p><div class="card-actions">{product.slug==='internal-affairs-bot'?<><a class="button" href="/products/internal-affairs-bot">View Product</a><a class="button-secondary" href="/docs/internal-affairs-bot">Docs</a></>:<a class="button-secondary" href="/docs/support?product=Custom%20Development">Enquire</a>}</div></article>)}</div></ProductLayout>

