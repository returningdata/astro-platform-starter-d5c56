---
import ProductLayout from '../../layouts/ProductLayout.astro';
---
<ProductLayout title="Customer Dashboard" description="Secure Kruiger Labs LLC customer products, licences, support, and service notices."><div id="dashboard-loading" class="hero-panel"><div class="eyebrow">Secure customer area</div><h1 class="page-title">Customer dashboard</h1><p>Checking your Discord session and product access…</p></div><div id="dashboard" class="hide"><section class="hero-panel"><div class="eyebrow">Authenticated customer portal</div><h1 class="page-title" id="customer-name">Customer dashboard</h1><p class="lead">Access products, licences, linked Discord servers, customer-only documentation, tickets, downloads, configuration resources, changelog notifications, announcements, billing references, project status, and security notices.</p><div class="hero-actions"><a class="button" href="/docs/support">Open support ticket</a><button class="button-secondary" id="logout">Sign out</button></div></section><section class="section"><h2>Your account</h2><div class="grid two"><article class="card"><h3>Purchased products and licences</h3><div id="licences"><p>No active licences are linked to this Discord account.</p></div></article><article class="card"><h3>Linked Discord servers</h3><div id="servers"><p>No verified servers are linked.</p></div></article><article class="card"><h3>Support tickets</h3><div id="tickets"><p>No authenticated tickets found.</p></div></article><article class="card"><h3>Customer resources</h3><p>Customer-only documentation and downloads appear here after a licence or custom project is assigned server-side.</p></article></div></section></div><div id="dashboard-login" class="hero-panel hide"><div class="eyebrow">Discord authentication</div><h1 class="page-title">Sign in to your customer dashboard</h1><p class="lead">Access is validated by secure Netlify Functions and database records, not browser-side role checks.</p><a class="button" href="/api/auth/discord?action=login&returnTo=/customer">Continue with Discord</a></div><script>const loading=document.querySelector('#dashboard-loading');const dashboard=document.querySelector('#dashboard');const login=document.querySelector('#dashboard-login');fetch('/api/customer/dashboard').then(async response=>{loading.classList.add('hide');if(response.status===401){login.classList.remove('hide');return}const data=await response.json();if(!response.ok){login.classList.remove('hide');return}dashboard.classList.remove('hide');document.querySelector('#customer-name').textContent=`Welcome, ${data.profile.displayName}`;const render=(id,items,template,empty)=>document.querySelector(id).innerHTML=items.length?items.map(template).join(''):`<p>${empty}</p>`;render('#licences',data.licences,x=>`<p><strong>${x.productName||'Product'}</strong><br>${x.reference} · ${x.status}</p>`,'No active licences are linked to this Discord account.');render('#servers',data.servers,x=>`<p><strong>${x.serverName}</strong><br>${x.discordServerId} · ${x.verified?'Verified':'Pending verification'}</p>`,'No verified servers are linked.');render('#tickets',data.tickets,x=>`<p><strong>${x.ticketNumber}</strong><br>${x.subject} · ${x.status}</p>`,'No authenticated tickets found.');}).catch(()=>{loading.classList.add('hide');login.classList.remove('hide')});document.querySelector('#logout').addEventListener('click',()=>fetch('/api/auth/logout').then(()=>location.reload()));</script></ProductLayout>

