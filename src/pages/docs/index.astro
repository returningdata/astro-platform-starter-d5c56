---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { documentedProducts } from '../../data/docs';
---
<DocsLayout title="Documentation" description="Everything you need to install, configure, host, secure, and operate your bot." activePath="">
  <section class="hero-panel docs-home-hero">
    <div class="eyebrow">Kruiger Labs LLC Docs</div>
    <h1 class="hero-title">Documentation</h1>
    <p class="lead">Everything you need to install, configure, host, secure, and operate your bot.</p>
    <div class="hero-actions"><button class="button" id="home-search-open">Search Documentation</button><a class="button-secondary" href="/docs/getting-started/">Start Here</a></div>
  </section>

  <section class="section" id="start-here"><div class="eyebrow">Start Here</div><h2>Prepare a safe installation</h2><ol class="steps"><li>Download and extract the purchased bot into a private directory.</li><li>Create your own Discord application; never use credentials supplied by another customer.</li><li>Configure the included <code>config.js</code>, <code>.env</code>, or buyer configuration file.</li><li>Install dependencies for the required Node.js or Python runtime.</li><li>Configure the database and any external service required by the product.</li><li>Start the bot and complete a controlled test before production use.</li></ol></section>

  <section class="section" id="products"><div class="eyebrow">Product catalogue</div><h2>Choose a product</h2><p>Choose a Kruiger Labs product below to access installation guides, configuration references, command documentation, integrations, troubleshooting, security guidance, and frequently asked questions.</p><div class="grid docs-product-grid">{documentedProducts.map(product => <article class="card docs-product-card"><div class="product-mark" aria-hidden="true">{product.name.slice(0, 2)}</div><div class="badges"><span class="badge good">Available</span><span class="badge">{product.time}</span></div><h3>{product.name}</h3><p>{product.description}</p><dl><div><dt>Primary use</dt><dd>{product.use}</dd></div><div><dt>Technology</dt><dd>{product.technology}</dd></div><div><dt>Difficulty</dt><dd>{product.difficulty}</dd></div></dl><a class="button-secondary" href={`/docs/${product.slug}/`}>View Documentation</a></article>)}</div></section>

  <section class="section" id="comparison"><div class="eyebrow">At a glance</div><h2>Product comparison</h2><div class="table-scroll"><table><thead><tr><th>Product</th><th>Runtime</th><th>Database</th><th>External service</th><th>Setup difficulty</th><th>Recommended for</th></tr></thead><tbody><tr><td>Scarlett</td><td>Node.js</td><td>MySQL or MariaDB</td><td>FiveM optional</td><td>Intermediate</td><td>FiveM communities and Discord management</td></tr><tr><td>Manager</td><td>Node.js</td><td>MySQL or MariaDB</td><td>FiveM, Tebex, FiveGuard optional</td><td>Intermediate</td><td>Community and FiveM management</td></tr><tr><td>DM RELAY</td><td>Python</td><td>MySQL or MariaDB</td><td>None</td><td>Easy</td><td>Private community contact and support</td></tr><tr><td>LEO TOOLKIT</td><td>Python</td><td>Backend API</td><td>Google Sheets and Google Cloud service account</td><td>Advanced</td><td>LEO departments and spreadsheet rosters</td></tr><tr><td>IAA BOT</td><td>Python</td><td>Companion website/backend</td><td>Discord OAuth2 and secured API</td><td>Advanced</td><td>Internal Affairs and multi-server intelligence</td></tr></tbody></table></div></section>
  <script>document.querySelector('#home-search-open')?.addEventListener('click',()=>document.querySelector<HTMLButtonElement>('#search-open')?.click());</script>
</DocsLayout>
