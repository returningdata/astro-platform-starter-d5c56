---
import DocsLayout from '../../layouts/DocsLayout.astro';
import { products } from '../../data/portal';
const toc=[{id:'catalogue',label:'Product catalogue'},{id:'quick-start',label:'Quick start'}];
---
<DocsLayout title="Welcome" description="Documentation, setup guides, command references, troubleshooting resources, and support for Kruiger Labs LLC products." toc={toc}>
  <section class="hero-panel"><div class="eyebrow">Kruiger Labs LLC Docs</div><h1 class="hero-title">Welcome to Kruiger Labs LLC Docs</h1><p class="lead">Professional documentation, setup guides, command references, troubleshooting resources, service updates, and customer support for every Kruiger Labs LLC product.</p><div class="hero-actions"><button class="button" onclick="document.querySelector('#search-open').click()">Search documentation</button><a class="button-secondary" href="/docs/internal-affairs-bot">Explore Internal Affairs Bot</a></div></section>
  <section class="section" id="catalogue"><div class="eyebrow">Product catalogue</div><h2>Start with a product</h2><p>Internal Affairs Bot is the first fully documented product. The catalogue is structured for future bots, websites, scripts, hosting products, integrations, and services.</p><div class="grid">{products.map((product)=><article class="card product-card" data-category={product.category}><img class="product-logo" src={product.logo || '/assets/logo.png'} alt="" /><div class="badges"><span class="badge good">{product.status}</span><span class="badge">{product.category}</span>{product.customerOnly&&<span class="badge">Customer only</span>}</div><h3>{product.name}</h3><p>{product.description}</p><div class="card-actions"><a class="button-secondary" href={product.slug==='internal-affairs-bot'?'/docs/internal-affairs-bot':'/docs/support'}>{product.slug==='internal-affairs-bot'?'Documentation':'Enquire'}</a><a class="button-secondary" href={`/docs/support?product=${encodeURIComponent(product.name)}`}>Support</a></div></article>)}</div></section>
  <section class="section" id="quick-start"><h2>Quick start</h2><div class="grid two"><a class="card" href="/docs/setup" style="text-decoration:none"><h3>Install and configure</h3><p>Invite the bot, map roles, configure channels, validate permissions, and test both review stages.</p></a><a class="card" href="/docs/commands" style="text-decoration:none"><h3>Browse commands</h3><p>Search every slash command by task, category, required role, option, or expected response.</p></a><a class="card" href="/docs/troubleshooting" style="text-decoration:none"><h3>Resolve a problem</h3><p>Use searchable troubleshooting checklists for commands, buttons, threads, reviews, and records.</p></a><a class="card" href="/docs/support" style="text-decoration:none"><h3>Contact support</h3><p>Open a secure support request, report a bug, request a feature, or discuss custom development.</p></a></div></section>
</DocsLayout>
