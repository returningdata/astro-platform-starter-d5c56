---
export const prerender = false;
import DocsLayout from '../../layouts/DocsLayout.astro';
import { commandCategories, commands, faqs, features, products, roles, services, troubleshooting } from '../../data/portal';
import { and, eq } from 'drizzle-orm';
import { getStore } from '@netlify/blobs';
import { db } from '../../../db/index';
import { documentationArticles, productLicences, users } from '../../../db/schema';
const slug=Astro.params.slug || '';
const [dynamicArticle] = await db.select().from(documentationArticles).where(eq(documentationArticles.slug, slug)).limit(1).catch(() => []);
let dynamicAllowed = Boolean(dynamicArticle?.status === 'published');
if (dynamicAllowed && dynamicArticle?.customerOnly) {
  const sessionId=(Astro.request.headers.get('cookie')||'').split(';').map(part=>part.trim()).find(part=>part.startsWith('session='))?.slice(8);
  const session=sessionId ? await getStore('sessions').get(sessionId,{type:'json'}).catch(()=>null) as {userId?:string;isAdmin?:boolean}|null : null;
  dynamicAllowed=Boolean(session?.isAdmin);
  if (!dynamicAllowed && session?.userId) {
    const [customer]=await db.select().from(users).where(eq(users.discordId,session.userId)).limit(1).catch(()=>[]);
    if (customer?.isCustomer) dynamicAllowed=true;
    if (!dynamicAllowed && customer && dynamicArticle.productId) {
      const [licence]=await db.select().from(productLicences).where(and(eq(productLicences.userId,customer.id),eq(productLicences.productId,dynamicArticle.productId),eq(productLicences.status,'active'))).limit(1).catch(()=>[]);
      dynamicAllowed=Boolean(licence);
    }
  }
}
const titles:Record<string,string>={catalogue:'Product Catalogue','internal-affairs-bot':'Internal Affairs Bot',setup:'Installation and Setup',commands:'Command Reference',permissions:'Roles and Permissions',workflows:'Approval Workflows',integrations:'Integrations',troubleshooting:'Troubleshooting Centre',faq:'Frequently Asked Questions',changelog:'Changelog',status:'Service Status',support:'Support Centre',contact:'Contact Kruiger Labs',privacy:'Privacy Policy',terms:'Terms of Service',security:'Security'};
const title=dynamicArticle?.title || titles[slug] || 'Documentation';
const tocMap:Record<string,{id:string,label:string}[]>={
  'internal-affairs-bot':[{id:'overview',label:'Overview'},{id:'features',label:'Features'},{id:'systems',label:'Product systems'},{id:'server-checks',label:'Member server checks'},{id:'support',label:'Support'}],
  setup:[{id:'installation',label:'Installation steps'},{id:'wizard',label:'Setup wizard'},{id:'validation',label:'Validation checklist'}],
  permissions:[{id:'permission-groups',label:'Permission groups'},{id:'discord-permissions',label:'Discord permissions'},{id:'least-privilege',label:'Least privilege'}],
  workflows:[{id:'approval-workflow',label:'Approval workflow'},{id:'review-rules',label:'Review rules'},{id:'completion',label:'Completion records'}],
  commands:commandCategories.map(category=>({id:category.toLowerCase(),label:category})),
};
const setupSteps=['Purchase or receive access to Internal Affairs Bot.','Sign in through Discord.','Select the Discord server and confirm authorised administrator access.','Invite the bot with application commands enabled.','Grant only the Discord permissions required for enabled features.','Run /setup.','Select administrative, investigator, reviewer, and High Command roles.','Configure investigation, case, blacklist, appeals, audit, and review channels.','Confirm punishment-review channel 1405663800312729625.','Confirm High Command final-review channel 1405663800522313759.','Configure case numbering, privacy, retention, threads, mentions, and branding.','Run /admin diagnostics.','Create a test case and submit a test review.','Confirm first-stage and High Command final review complete correctly.','Move the bot into production use.'];
const discordPermissions=[['View Channels','Reads configured case, review, log, and thread channels.'],['Send Messages','Posts cases, requests, notifications, and status updates.'],['Embed Links','Displays structured case and review embeds.'],['Attach Files','Posts authorised evidence and generated exports.'],['Read Message History','Restores context and updates existing review messages.'],['Create Public Threads','Creates public workflow threads when configured.'],['Create Private Threads','Creates restricted investigation and review threads.'],['Send Messages in Threads','Maintains case and review discussions.'],['Manage Threads','Archives, renames, and manages bot-created threads.'],['Use Application Commands','Registers and runs Discord slash commands.'],['Manage Messages','Optional; used only where workflow cleanup is enabled.'],['Manage Roles','Optional; required only for role automation.'],['Moderate Members','Optional; required only for punishment automation.'],['Ban Members','Optional; required only for automatic bans.'],['Kick Members','Optional; required only for automatic removals.']];
const productParam=Astro.url.searchParams.get('product') || 'Internal Affairs Bot';
---
<DocsLayout title={title} active={title} toc={tocMap[slug] || []}>
  {dynamicArticle && dynamicAllowed && <><div class="eyebrow">{dynamicArticle.customerOnly?'Customer documentation':'Published documentation'} · v{dynamicArticle.version}</div><h1 class="page-title">{dynamicArticle.title}</h1><p class="lead">{dynamicArticle.summary}</p><article class="section" style="white-space:pre-wrap">{dynamicArticle.content}</article></>}
  {dynamicArticle?.customerOnly && !dynamicAllowed && <section class="hero-panel"><div class="eyebrow">Customer-only documentation</div><h1 class="page-title">Authorised access required</h1><p class="lead">Sign in with Discord. Product access is validated server-side before restricted content is returned.</p><a class="button" href={`/api/auth/discord?action=login&returnTo=/docs/${slug}`}>Continue with Discord</a></section>}
  {slug==='catalogue' && <>
    <div class="eyebrow">Expandable product directory</div><h1 class="page-title">Product catalogue</h1><p class="lead">Browse Kruiger Labs LLC bots, websites, dashboards, hosting, automations, integrations, and custom-development services.</p>
    <input id="catalogue-search" class="content-search" placeholder="Search products and services" />
    <div class="filterbar" id="catalogue-filters"><button class="filter active" data-filter="all">All</button>{['Discord Bots','Websites','Dashboards','Moderation Systems','Roleplay Systems','Automation','Hosting','Custom Development','Integrations','Other Products'].map(x=><button class="filter" data-filter={x}>{x}</button>)}</div>
    <div class="filterbar"><span class="badge good">Available</span><span class="badge">Coming Soon</span><span class="badge">In Development</span><span class="badge">Maintenance</span><span class="badge">Customer Only</span><span class="badge">Free</span><span class="badge">Paid</span><span class="badge">Custom Quote</span></div>
    <div class="grid" id="catalogue-grid">{products.map(product=><article class="card product-card" data-category={product.category} data-search={`${product.name} ${product.description} ${product.category}`.toLowerCase()}><img class="product-logo" src={product.logo || '/assets/logo.png'} alt=""/><div class="badges"><span class="badge good">{product.status}</span><span class="badge">v{product.version}</span>{product.customerOnly&&<span class="badge">Customer only</span>}</div><h3>{product.name}</h3><p>{product.description}</p><div class="card-actions"><a class="button-secondary" href={product.slug==='internal-affairs-bot'?'/docs/internal-affairs-bot':'/docs/support'}>Documentation</a><a class="button-secondary" href={`/docs/support?product=${encodeURIComponent(product.name)}`}>Support</a><a class="button-secondary" href="/products/internal-affairs-bot/request-access">Enquire</a></div></article>)}</div>
    <script>let cards=[...document.querySelectorAll<HTMLElement>('#catalogue-grid .product-card')];let filter='all';const search=document.querySelector<HTMLInputElement>('#catalogue-search');const apply=()=>cards.forEach(card=>card.classList.toggle('hide',!(filter==='all'||card.dataset.category===filter)||!card.dataset.search?.includes(search?.value.toLowerCase()||'')));document.querySelectorAll<HTMLButtonElement>('#catalogue-filters .filter').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('#catalogue-filters .filter').forEach(x=>x.classList.remove('active'));button.classList.add('active');filter=button.dataset.filter||'all';apply()}));search?.addEventListener('input',apply);fetch('/api/docs/content?resource=products').then(response=>response.json()).then(data=>{const grid=document.querySelector('#catalogue-grid');const known=new Set(cards.map(card=>card.querySelector('h3')?.textContent));for(const product of data.items||[]){if(known.has(product.name)||!grid)continue;const card=document.createElement('article');card.className='card product-card';card.dataset.category=product.category;card.dataset.search=`${product.name} ${product.description} ${product.category}`.toLowerCase();const logo=document.createElement('img');logo.className='product-logo';logo.src=product.logoUrl||'/assets/logo.png';logo.alt='';const badges=document.createElement('div');badges.className='badges';const statusBadge=document.createElement('span');statusBadge.className='badge good';statusBadge.textContent=product.status;badges.append(statusBadge);if(product.customerOnly){const accessBadge=document.createElement('span');accessBadge.className='badge';accessBadge.textContent='Customer only';badges.append(accessBadge)}const heading=document.createElement('h3');heading.textContent=product.name;const description=document.createElement('p');description.textContent=product.description;const actions=document.createElement('div');actions.className='card-actions';const docs=document.createElement('a');docs.className='button-secondary';docs.href=`/docs/${product.slug}`;docs.textContent='Documentation';const support=document.createElement('a');support.className='button-secondary';support.href=`/docs/support?product=${encodeURIComponent(product.name)}`;support.textContent='Support';actions.append(docs,support);card.append(logo,badges,heading,description,actions);grid.append(card)}cards=[...document.querySelectorAll<HTMLElement>('#catalogue-grid .product-card')];apply()}).catch(()=>{});</script>
  </>}

  {slug==='internal-affairs-bot' && <>
    <section class="hero-panel" id="overview"><div class="eyebrow">Discord administration platform</div><div style="display:flex;gap:22px;align-items:center;position:relative;z-index:1"><img src="/assets/internal-affairs/logo.png" alt="Internal Affairs Bot logo" style="width:96px;height:96px;border-radius:24px;object-fit:cover"/><div><h1 class="page-title">Internal Affairs Bot</h1><div class="badges"><span class="badge good">Available</span><span class="badge">Version 1.0</span><span class="badge">Support available</span></div></div></div><p class="lead">A professional Discord investigation, case-management, blacklist, punishment-review, and administrative-record system designed for roleplay communities, gaming communities, staff teams, law-enforcement departments, and multi-server organisations.</p><p>Authorised personnel can create and manage cases, investigate users and servers, submit blacklist and punishment requests, collect evidence, conduct multi-stage approvals, and maintain detailed administrative records. Standard reviewers and High Command reviewers operate in separate, configurable stages.</p><div class="hero-actions"><a class="button" href="/docs/setup">Install and configure</a><a class="button-secondary" href="/docs/commands">View commands</a><a class="button-secondary" href="/docs/support?product=Internal%20Affairs%20Bot">Get support</a></div></section>
    <section class="section" id="features"><h2>Features</h2><ul class="feature-list">{features.map(feature=><li>{feature}</li>)}</ul></section>
    <section class="section" id="systems"><h2>Product systems</h2><div class="grid two">{['Case System','User Investigation System','Server Investigation System','Blacklist System','Punishment Request System','Approval System','Evidence Management','Logging and Security'].map((name,index)=><article class="card"><h3>{name}</h3><p>{['Structured cases with numbers, status, notes, evidence, assignments, threads, history, export, closure, and reopening.','Known-case, punishment and blacklist checks with privacy-controlled mutual-server indicators.','Server records, owners, invites, prior investigations, blacklist history, evidence, and review discussions.','User and server submissions with first-stage review, High Command escalation, reviewer tracking, and removals.','Configurable punishment types, evidence, department context, staged review, revocation, editing, and cancellation.','Approve, Deny, Request Information, claim, release, queue, history, and tightly restricted overrides.','Attachments, links, statements, descriptions, timestamps, case association, and permission-filtered exports.','Case, investigation, punishment, blacklist, review and configuration audit trails with configurable access.'][index]}</p></article>)}</div></section>
    <section class="section" id="server-checks"><h2>Member server checks</h2><div class="callout warning"><strong>Visibility limitation:</strong> Internal Affairs Bot may only identify mutual servers where the bot is installed and has access to the necessary information. It must never claim it can display every Discord server a user has joined.</div><p>When a command involves a user, the bot checks authorised mutual servers, may list server name and ID, logs when the check occurred, posts results in the related case or review thread, shows when no visible mutual servers exist, and respects privacy settings.</p><p>Configurable indicators can include: Roleplay, RP, Leaks, Blacklist, Scam, Exploit, Cheating, Staff Abuse, Ban Evasion, Alternate Account, Fraud, and Internal Affairs. A keyword match is an indicator for human review—not proof of wrongdoing.</p></section>
    <section class="section" id="support"><h2>Support and custom configuration</h2><p>Kruiger Labs LLC provides product setup, command, configuration, billing, bug, feature, security, privacy, and custom-development support.</p><a class="button" href="/docs/support?product=Internal%20Affairs%20Bot">Open Support Centre</a></section>
  </>}

  {slug==='setup' && <><div class="eyebrow">Internal Affairs Bot</div><h1 class="page-title">Installation and initial setup</h1><p class="lead">Complete setup in a test environment before enabling production case and review workflows.</p><section class="section" id="installation"><h2>Installation steps</h2><ol class="steps">{setupSteps.map(step=><li>{step}</li>)}</ol></section><section class="section" id="wizard"><h2>What /setup configures</h2><div class="grid two">{['Administrative, investigator, reviewer, and High Command roles','Case, user-investigation, and server-investigation channels','Punishment, final review, user blacklist, and server blacklist channels','Appeals, audit log, confidential case, and notification settings','Default review requirements and same-reviewer policy','Branding, case number format, threads, mentions, privacy, and retention'].map(item=><div class="card"><p>{item}</p></div>)}</div></section><section class="section" id="validation"><h2>Production validation</h2><div class="callout">Run <code>/admin diagnostics</code>, create a test case, submit a test punishment request, complete first-stage review with one authorised reviewer, and complete final review with High Command. Confirm the original message shows both reviewers and the final status.</div></section></>}

  {slug==='commands' && <><div class="eyebrow">Internal Affairs Bot · v1.0</div><h1 class="page-title">Command reference</h1><p class="lead">Search by command, task, option, role, or natural-language phrase such as “How do I blacklist a user?”</p><input class="content-search" id="command-search" placeholder="Search commands — e.g. approve a punishment"/><div class="filterbar" id="command-filters"><button class="filter active" data-category="all">All</button>{commandCategories.map(category=><button class="filter" data-category={category}>{category}</button>)}</div><div id="command-list">{commands.map(item=>{const id=item.name.replace(/[ /]/g,'-').replace(/^-+/,'');return <article class="command-card" id={id} data-category={item.category} data-search={`${item.name} ${item.description} ${item.response} ${item.options.map(x=>x.name).join(' ')}`.toLowerCase()}><header class="command-head"><div><div class="command-name">{item.name}</div><strong>{item.description}</strong></div><button class="copy" data-copy={item.name}>Copy command</button></header><div class="command-body"><div class="command-meta"><div class="meta"><strong>Permission</strong><br/>{item.permission}</div><div class="meta"><strong>Default role</strong><br/>{item.role}</div></div>{item.options.length>0&&<table class="options"><thead><tr><th>Option</th><th>Description</th><th>Choices</th></tr></thead><tbody>{item.options.map(item=><tr><td><code>{item.name}</code></td><td>{item.description}</td><td>{item.choices?.join(', ') || 'Server value'}</td></tr>)}</tbody></table>}<h3>Example usage</h3><div class="code">{item.example}</div><h3>Expected response</h3><p>{item.response}</p><h3>Common errors</h3><ul>{item.errors.map(error=><li>{error}</li>)}</ul>{item.related.length>0&&<p><strong>Related commands:</strong> {item.related.join(', ')}</p>}<div class="callout"><strong>Notes:</strong> {item.notes}</div></div></article>})}</div><script>let category='all';const search=document.querySelector<HTMLInputElement>('#command-search');const commandCards=[...document.querySelectorAll<HTMLElement>('.command-card')];const apply=()=>commandCards.forEach(card=>card.classList.toggle('hide',!(category==='all'||card.dataset.category===category)||!card.dataset.search?.includes(search?.value.toLowerCase()||'')));search?.addEventListener('input',apply);document.querySelectorAll<HTMLButtonElement>('#command-filters button').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('#command-filters button').forEach(x=>x.classList.remove('active'));button.classList.add('active');category=button.dataset.category||'all';apply()}));document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button=>button.addEventListener('click',async()=>{await navigator.clipboard.writeText(button.dataset.copy||'');button.textContent='Copied'}));</script></>}

  {slug==='permissions' && <><div class="eyebrow">Customisable Discord roles</div><h1 class="page-title">Roles and permissions</h1><p class="lead">Every permission group maps to one or more configurable Discord roles. Frontend role claims are never trusted for protected customer or staff operations.</p><section class="section" id="permission-groups"><h2>Default permission groups</h2><div class="grid two">{roles.map(([name,description])=><article class="card"><h3>{name}</h3><p>{description}</p></article>)}</div></section><section class="section" id="discord-permissions"><h2>Required Discord permissions</h2><div class="callout warning">Grant only the permissions required for features you actually enable.</div><table class="options"><thead><tr><th>Permission</th><th>Why it is needed</th></tr></thead><tbody>{discordPermissions.map(([name,reason])=><tr><td><strong>{name}</strong></td><td>{reason}</td></tr>)}</tbody></table></section><section class="section" id="least-privilege"><h2>Least-privilege guidance</h2><p>Keep the bot role below protected administration roles. Do not grant Manage Roles, moderation, ban, or kick permissions unless the corresponding automation is intentionally enabled. Restrict confidential channels and threads to the exact roles that require access.</p></section></>}

  {slug==='workflows' && <><div class="eyebrow">Punishment and blacklist requests</div><h1 class="page-title">Approval workflows</h1><p class="lead">Every reviewable submission displays Approve and Deny controls, supports distinct review stages, records reviewer identity, and updates the original message when complete.</p><section class="section" id="approval-workflow"><h2>Four-stage review</h2><div class="workflow">{[['Submission','Staff submits; validation, embed, thread, record checks, and first-stage delivery run.'],['First review','An authorised reviewer claims, approves, denies, or requests information; decision and reason are logged.'],['High Command review','Approved requests move to final review. High Command and above receive Approve and Deny controls.'],['Completion','Original message updates, both reviewers display, submitter is notified, records and audit logs update.']].map(([name,text])=><article class="card"><h3>{name}</h3><p>{text}</p></article>)}</div></section><section class="section" id="review-rules"><h2>Review rules</h2><ul><li>The submitter cannot approve their own request unless an authorised policy explicitly allows it.</li><li>The same reviewer cannot perform both stages unless an authorised override exists.</li><li>Required reviewer counts are configurable per request type.</li><li>High Command and authorised higher ranks can complete stage two.</li><li>Decisions, reasons, timestamps, claims, releases, and overrides are audited.</li></ul></section><section class="section" id="completion"><h2>Completed request record</h2><div class="code">Status: Approved | Denied | Cancelled | More Information Required<br/>Submitted by: …<br/>First reviewed by: …<br/>Final reviewed by: …<br/>Date submitted: …<br/>Date completed: …<br/>Final reason: …<br/>Case number: …</div></section></>}

  {slug==='troubleshooting' && <><div class="eyebrow">Searchable support articles</div><h1 class="page-title">Troubleshooting centre</h1><input id="trouble-search" class="content-search" placeholder="Search symptoms, causes, and resolutions"/><div id="trouble-list">{troubleshooting.map(([name,causes,resolution])=>{const id=String(name).toLowerCase().replace(/[^a-z0-9]+/g,'-');return <section class="section trouble" id={id} data-search={`${name} ${(causes as string[]).join(' ')} ${resolution}`.toLowerCase()}><h2>{name}</h2><div class="grid two"><article class="card"><h3>Possible causes</h3><ul>{(causes as string[]).map(cause=><li>{cause}</li>)}</ul></article><article class="card"><h3>Resolution</h3><p>{resolution}</p></article></div></section>})}</div><script>const troubleSearch=document.querySelector<HTMLInputElement>('#trouble-search');const troubles=[...document.querySelectorAll<HTMLElement>('.trouble')];troubleSearch?.addEventListener('input',()=>troubles.forEach(item=>item.classList.toggle('hide',!item.dataset.search?.includes(troubleSearch.value.toLowerCase()))));</script></>}

  {slug==='faq' && <><div class="eyebrow">Internal Affairs Bot</div><h1 class="page-title">Frequently asked questions</h1><div class="faq">{faqs.map(([question,answer])=><details><summary>{question}</summary><p>{answer}</p></details>)}</div></>}

  {slug==='status' && <><div class="eyebrow">Public operational view</div><h1 class="page-title">Service status</h1><p class="lead">Current public status without exposing internal infrastructure details.</p><div class="callout"><strong>All systems operational.</strong> No active incidents are published.</div><section class="section"><h2>Services</h2><div id="service-list">{services.map(service=><div class="status-row" data-service={service}><strong>{service}</strong><span class="status-pill">Operational</span></div>)}</div></section><section class="section"><h2>Status definitions</h2><div class="badges"><span class="badge good">Operational</span><span class="badge">Degraded Performance</span><span class="badge">Partial Outage</span><span class="badge">Major Outage</span><span class="badge">Maintenance</span></div><h3>Incident history</h3><p>No public incidents have been recorded for this initial documentation release.</p></section><script>fetch('/api/docs/content?resource=services').then(response=>response.json()).then(data=>{const container=document.querySelector('#service-list');for(const service of data.items||[]){let row=[...document.querySelectorAll<HTMLElement>('[data-service]')].find(item=>item.dataset.service===service.name);if(!row&&container){row=document.createElement('div');row.className='status-row';row.dataset.service=service.name;const name=document.createElement('strong');name.textContent=service.name;const pill=document.createElement('span');pill.className='status-pill';row.append(name,pill);container.append(row)}const pill=row?.querySelector<HTMLElement>('.status-pill');if(pill)pill.textContent=service.status.replaceAll('-',' ').replace(/\b\w/g,(letter:string)=>letter.toUpperCase())}}).catch(()=>{});</script></>}

  {slug==='changelog' && <><div class="eyebrow">Product releases</div><h1 class="page-title">Changelog</h1><div class="filterbar">{['Internal Affairs Bot','Website','Dashboard','Discord Integration','Security','All Products'].map((x,i)=><button class={`filter ${i===0?'active':''}`}>{x}</button>)}</div><section class="section"><div class="badges"><span class="badge">Version 1.0</span><span class="badge good">July 27, 2026</span></div><h2>Internal Affairs Bot documentation launch</h2><div class="grid two"><article class="card"><h3>New features</h3><ul><li>Complete case and investigation documentation</li><li>Blacklist and punishment review workflows</li><li>High Command final-review guidance</li><li>Searchable command reference</li></ul></article><article class="card"><h3>Improvements</h3><ul><li>Customer dashboard and support ticket access</li><li>Product catalogue and service status views</li><li>Mobile documentation navigation</li></ul></article><article class="card"><h3>Security updates</h3><ul><li>OAuth state validation</li><li>HTTP-only sessions and CSRF-protected mutations</li><li>Server-side customer and staff access checks</li></ul></article><article class="card"><h3>Known issues</h3><p>No known documentation issues at release. Product-specific notices appear here when published.</p></article></div></section></>}

  {slug==='support' && <><div class="eyebrow">Secure customer support</div><h1 class="page-title">Support centre</h1><p class="lead">Get setup help, report a bug, request a feature, discuss billing, submit a privacy request, or enquire about custom development.</p><form class="support-form" id="support-form" enctype="multipart/form-data"><div class="field"><label>Customer name *</label><input name="customerName" required/></div><div class="field"><label>Discord username *</label><input name="discordUsername" required/></div><div class="field"><label>Discord user ID *</label><input name="discordUserId" inputmode="numeric" pattern="[0-9]{15,22}" required/></div><div class="field"><label>Email address *</label><input type="email" name="email" required/></div><div class="field"><label>Product *</label><select name="product"><option selected={productParam==='Internal Affairs Bot'}>Internal Affairs Bot</option>{products.filter(x=>x.name!=='Internal Affairs Bot').map(product=><option selected={productParam===product.name}>{product.name}</option>)}</select></div><div class="field"><label>Support category *</label><select name="category">{['General Support','Product Setup','Internal Affairs Bot Support','Command Help','Configuration Help','Billing and Purchases','Bug Report','Feature Request','Security Report','Data and Privacy Request','Custom Development Enquiry','Account Access','Other'].map(x=><option>{x}</option>)}</select></div><div class="field"><label>Server name</label><input name="serverName"/></div><div class="field"><label>Server ID</label><input name="serverId" inputmode="numeric"/></div><div class="field"><label>Priority</label><select name="priority"><option value="low">Low</option><option value="normal" selected>Normal</option><option value="high">High</option><option value="urgent">Urgent</option><option value="critical">Critical</option><option value="service-issue">Service Issue</option></select></div><div class="field"><label>Relevant command</label><input name="relevantCommand" placeholder="/case create"/></div><div class="field full"><label>Subject *</label><input name="subject" required/></div><div class="field full"><label>Description *</label><textarea name="description" minlength="20" required></textarea></div><div class="field full"><label>Steps already attempted</label><textarea name="stepsAttempted"></textarea></div><div class="field"><label>Case or request ID</label><input name="relatedRecordId"/></div><div class="field"><label>Error message</label><input name="errorMessage"/></div><div class="field full"><label>Screenshots or files (up to 5; PNG, JPG, WebP, TXT, PDF; 5 MB each)</label><input type="file" name="attachments" multiple accept="image/png,image/jpeg,image/webp,text/plain,application/pdf"/></div><div class="field full"><label><input type="checkbox" name="diagnosticConsent" value="true" style="width:auto"/> I permit authorised support staff to access relevant diagnostic information.</label></div><div class="full"><button class="button" type="submit">Submit support request</button></div><div class="form-status full" id="support-status"></div></form><section class="section"><h2>Ticket statuses</h2><div class="badges">{['Open','Assigned','Waiting for Customer','Under Investigation','Escalated','Resolved','Closed'].map(x=><span class="badge">{x}</span>)}</div><p>Sign in to the <a href="/customer">customer dashboard</a> to view submitted tickets and replies.</p></section><script>const form=document.querySelector<HTMLFormElement>('#support-form');const status=document.querySelector<HTMLElement>('#support-status');form?.addEventListener('submit',async event=>{event.preventDefault();if(!status)return;status.className='form-status full show';status.textContent='Submitting securely…';const session=await fetch('/api/auth/session').then(r=>r.json()).catch(()=>({}));const response=await fetch('/api/support/tickets',{method:'POST',headers:session.csrfToken?{'x-csrf-token':session.csrfToken}:{},body:new FormData(form)});const data=await response.json();if(response.ok){status.classList.add('success');status.textContent=`Support request received. Your ticket number is ${data.ticketNumber}.`;form.reset()}else{status.classList.add('error');status.textContent=data.error||'Unable to submit the request.'}});</script></>}

  {slug==='integrations' && <><div class="eyebrow">Connected workflows</div><h1 class="page-title">Integrations</h1><p class="lead">Internal Affairs Bot is built around Discord application commands, channels, threads, roles, embeds, buttons, modal forms, attachments, and secure server-side services.</p><div class="grid two"><article class="card"><h3>Discord</h3><p>OAuth sign-in, slash commands, configurable roles and channels, private threads, embeds, buttons, modal forms, autocomplete, and notifications.</p></article><article class="card"><h3>Kruiger Labs support</h3><p>Authenticated customer tickets, diagnostic consent, product access, service notices, changelogs, and custom configuration resources.</p></article><article class="card"><h3>Server-side notifications</h3><p>Support notifications can be sent from secure Netlify Functions when configured. Webhook URLs and tokens never enter browser code.</p></article><article class="card"><h3>Future integrations</h3><p>The product and documentation models support additional dashboards, hosting systems, websites, automation tools, and custom services.</p></article></div></>}

  {['contact','privacy','terms','security'].includes(slug) && <><div class="eyebrow">Kruiger Labs LLC</div><h1 class="page-title">{title}</h1>{slug==='contact'&&<><p class="lead">Contact Kruiger Labs LLC for product access, support, custom development, integrations, hosting, websites, and documentation enquiries.</p><div class="hero-actions"><a class="button" href="/docs/support">Open Support Centre</a><a class="button-secondary" href="/products/internal-affairs-bot/request-access">Request product access</a></div></>}{slug==='privacy'&&<><p class="lead">Kruiger Labs LLC products use role-based access, privacy settings, configurable retention, permission-filtered exports, and secure customer validation.</p><p>Mutual-server checks are limited to servers where the bot is installed and authorised. They never reveal a user's complete Discord server membership.</p></>}{slug==='terms'&&<><p class="lead">Use Kruiger Labs LLC products only in servers and workflows you are authorised to administer.</p><p>Administrators remain responsible for appropriate permissions, lawful records, retention settings, staff access, and human review of indicators and decisions.</p></>}{slug==='security'&&<><p class="lead">Security reports receive restricted handling through the Support Centre.</p><p>The portal uses server-side authentication, HTTP-only sessions, OAuth state validation, CSRF checks, rate limits, input validation, database parameterisation, file restrictions, audit logs, and environment-managed secrets.</p><div class="callout warning">Never submit bot tokens, API secrets, webhook URLs, passwords, or private credentials in a support ticket.</div></>}</>}

