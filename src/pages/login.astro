---
import KruigerLayout from '../layouts/KruigerLayout.astro';
import Container from '../components/kl/Container.astro';
import GlowPanel from '../components/kl/GlowPanel.astro';
import Wordmark from '../components/kl/Wordmark.astro';
import Icon from '../components/kl/Icon.astro';
import BackgroundGrid from '../components/kl/BackgroundGrid.astro';
---

<KruigerLayout
    title="Staff Sign In | Kruiger Labs LLC"
    description="Sign in with Discord to access the Kruiger Labs staff dashboard."
    noindex
>
    <section class="login">
        <BackgroundGrid orbs />
        <Container size="narrow" class="login__inner">
            <GlowPanel class="login__card">
                <Wordmark mark={44} size="1.15rem" stacked class="login__brand" />

                <h1 class="kl-display login__title">
                    <span class="kl-metal">Staff</span>
                    <span class="kl-violet"> Access</span>
                </h1>
                <p class="login__copy">
                    Sign in with Discord to reach the staff dashboard. You need an authorised role in the Kruiger Labs
                    Discord server.
                </p>

                <a href="/api/auth/discord?action=login" class="kl-btn kl-btn--primary kl-btn--lg login__discord">
                    <Icon name="discord" size={20} />
                    Sign in with Discord
                </a>

                <div class="login__links">
                    <a class="kl-link" href="/">Back to home</a>
                    <a class="kl-link" href="/customer">Client portal</a>
                </div>
            </GlowPanel>
        </Container>
    </section>
</KruigerLayout>

<style>
    .login {
        position: relative;
        display: flex;
        align-items: center;
        min-height: calc(100vh - var(--kl-nav-h));
        padding: calc(var(--kl-nav-h) + 40px) 0 60px;
    }

    .login :global(.login__inner) {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: center;
    }

    .login :global(.login__card) {
        width: min(460px, 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 18px;
        padding: clamp(30px, 6vw, 48px) clamp(22px, 5vw, 40px);
        text-align: center;
    }

    .login :global(.login__brand) {
        margin-bottom: 4px;
    }

    .login__title {
        margin: 0;
        font-size: clamp(1.5rem, 4vw, 2.1rem);
        text-transform: uppercase;
        letter-spacing: 0.08em;
    }

    .login__copy {
        margin: 0;
        color: var(--kl-text-muted);
        font-size: 0.92rem;
        line-height: 1.7;
    }

    .login__discord {
        width: 100%;
        gap: 12px;
    }

    .login__links {
        display: flex;
        gap: 20px;
        font-size: 0.84rem;
    }
</style>
