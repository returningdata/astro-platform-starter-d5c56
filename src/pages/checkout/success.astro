---
import ProductLayout from '../../layouts/ProductLayout.astro';
---
<ProductLayout title="Payment Received" description="Verify your Kruiger Labs order and access fulfillment links."><section class="hero-panel"><div class="eyebrow">Secure checkout result</div><h1 class="page-title">Payment received</h1><p class="lead">Stripe has returned you to Kruiger Labs. Your order and entitlements appear after the verified webhook completes.</p><div id="checkout-result"><p>Verifying the order against your authenticated account…</p></div></section><script>const root=document.querySelector('#checkout-result');const sessionId=new URLSearchParams(location.search).get('session_id');if(!sessionId){root.innerHTML='<p>Missing Checkout Session reference. Open the Client Portal to view your orders.</p>'}else{fetch(`/api/store/checkout-result?session_id=${encodeURIComponent(sessionId)}`).then(async response=>{if(response.status===401){location.href=`/api/auth/discord?action=login&returnTo=${encodeURIComponent(location.pathname+location.search)}`;return}const data=await response.json();if(!response.ok){root.innerHTML=`<div class="callout warning"><strong>Order verification pending</strong><p>${data.error||'Open the Client Portal in a moment.'}</p></div>`;return}const order=data.order;root.innerHTML=`<div class="result-grid"><article><span>Order number</span><strong>${order.orderNumber}</strong></article><article><span>Payment</span><strong>${order.paymentStatus}</strong></article><article><span>Fulfillment</span><strong>${order.fulfillmentStatus}</strong></article><article><span>Total</span><strong>${new Intl.NumberFormat('en-US',{style:'currency',currency:order.currency.toUpperCase()}).format(order.totalCents/100)}</strong></article></div><h2>Purchased items</h2><div class="result-items">${data.items.map(item=>`<p><strong>${item.productName}</strong><span>${item.itemType==='setup_service'?'Setup service':'Digital product'}</span></p>`).join('')}</div><div class="hero-actions"><a class="button" href="/customer/">Open Client Portal</a><a class="button-secondary" href="/docs/">Documentation</a><a class="button-secondary" href="/support">Support</a></div>`}).catch(()=>root.innerHTML='<p>Unable to verify the order right now. Open the Client Portal to check fulfillment.</p>')}</script><style is:global>.result-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:22px 0}.result-grid article{display:grid;gap:5px;padding:15px;border:1px solid var(--line);border-radius:10px;background:rgba(18,18,25,.7)}.result-grid span,.result-items span{color:var(--muted);font-size:.78rem;text-transform:capitalize}.result-items p{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--line)}@media(max-width:720px){.result-grid{grid-template-columns:1fr 1fr}}</style></ProductLayout>

