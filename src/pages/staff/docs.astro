---
import ProductLayout from '../../layouts/ProductLayout.astro';
---
<ProductLayout title="Documentation Management" description="Restricted Kruiger Labs LLC documentation management."><meta name="robots" content="noindex,nofollow"/><div id="staff-denied" class="hero-panel"><div class="eyebrow">Restricted staff system</div><h1 class="page-title">Verifying staff access</h1><p>Documentation-management data is available only after server-side Discord session and role validation.</p></div><div id="staff-app" class="hide"><div class="eyebrow">Kruiger Labs staff</div><h1 class="page-title">Documentation management</h1><p class="lead">Add and edit products, articles, setup guides, command content, FAQs, troubleshooting, changelogs, customer-only access, product versions, service status, and feedback.</p><div class="filterbar" id="resource-tabs">{['articles','products','services','tickets','changelog'].map((item,i)=><button class={`filter ${i===0?'active':''}`} data-resource={item}>{item}</button>)}</div><div class="grid two"><section class="card"><h3>Published records</h3><div id="staff-list"><p>Loading…</p></div></section><section class="card"><h3>Create documentation article</h3><form id="article-form" class="support-form"><div class="field full"><label>Title</label><input name="title" required/></div><div class="field full"><label>Slug</label><input name="slug" pattern="[a-z0-9-]+" required/></div><div class="field full"><label>Summary</label><textarea name="summary" required></textarea></div><div class="field full"><label>Content</label><textarea name="content" style="min-height:260px" required></textarea></div><div class="field"><label>Status</label><select name="status"><option>draft</option><option>published</option><option>unpublished</option></select></div><div class="field"><label>Version</label><input name="version" value="1.0"/></div><div class="field full"><label>Search keywords</label><input name="searchKeywords"/></div><div class="field full"><label><input type="checkbox" name="customerOnly" style="width:auto"/> Customer-only access</label></div><div><button class="button">Save article</button></div><div class="form-status full" id="staff-status"></div></form></section></div></div><script>let csrf='';let resource='articles';const denied=document.querySelector<HTMLElement>('#staff-denied');const app=document.querySelector<HTMLElement>('#staff-app');const list=document.querySelector<HTMLElement>('#staff-list');const load=async()=>{const response=await fetch(`/api/staff/docs?resource=${resource}`);if(response.status===401||response.status===403){if(denied)denied.innerHTML='<h1 class="page-title">Staff access required</h1><a class="button" href="/api/auth/discord?action=login&returnTo=/staff/docs">Sign in with Discord</a>';return}const data=await response.json();denied?.classList.add('hide');app?.classList.remove('hide');if(list)list.innerHTML=data.items?.length?data.items.map((item:Record<string,string>)=>`<p><strong>${item.title||item.name||item.ticketNumber||item.version}</strong><br>${item.status||item.category||''}</p>`).join(''):'<p>No records in this resource.</p>'};fetch('/api/auth/session').then(r=>r.json()).then(data=>{csrf=data.csrfToken||'';load()});document.querySelectorAll<HTMLButtonElement>('#resource-tabs button').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('#resource-tabs button').forEach(x=>x.classList.remove('active'));button.classList.add('active');resource=button.dataset.resource||'articles';load()}));const form=document.querySelector<HTMLFormElement>('#article-form');form?.addEventListener('submit',async event=>{event.preventDefault();const body:Record<string,unknown>=Object.fromEntries(new FormData(form));body.customerOnly=body.customerOnly==='on';const response=await fetch('/api/staff/docs?resource=articles',{method:'POST',headers:{'Content-Type':'application/json','x-csrf-token':csrf},body:JSON.stringify(body)});const data=await response.json();const status=document.querySelector<HTMLElement>('#staff-status');if(status){status.className=`form-status full show ${response.ok?'success':'error'}`;status.textContent=response.ok?'Article saved and audit logged.':(data.error||'Unable to save article.')}if(response.ok){form.reset();load()}});</script></ProductLayout>
