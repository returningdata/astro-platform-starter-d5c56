---
import KruigerLayout from '../layouts/KruigerLayout.astro';
import Container from '../components/kl/Container.astro';
import Button from '../components/kl/Button.astro';
import Card from '../components/kl/Card.astro';
import Icon from '../components/kl/Icon.astro';
import Badge from '../components/kl/Badge.astro';
import SectionHeader from '../components/kl/SectionHeader.astro';
import ServiceCard from '../components/kl/ServiceCard.astro';
import ProductGrid from '../components/kl/ProductGrid.astro';
import GlowPanel from '../components/kl/GlowPanel.astro';
import BackgroundGrid from '../components/kl/BackgroundGrid.astro';

import { SITE, SERVICES, CLOUDNORD, WHY, TECHNOLOGIES } from '../data/site';
import { products, commands, docNav } from '../data/portal';

/** Hero capability icons, mirroring the brand banner's icon row. */
const heroIcons = [
    { icon: 'code', label: 'Software' },
    { icon: 'server', label: 'Infrastructure' },
    { icon: 'cloud', label: 'Cloud' },
    { icon: 'shield', label: 'Security' },
    { icon: 'globe', label: 'Web' }
];

/**
 * Every figure below is counted from real catalogue data — no invented
 * customer counts or uptime percentages.
 */
const stats = [
    { value: products.length, label: 'Products & services', detail: 'Listed in the live catalogue' },
    { value: commands.length, label: 'Documented commands', detail: 'Across product reference content' },
    { value: docNav.length, label: 'Documentation sections', detail: 'Setup, reference and support' },
    { value: SERVICES.length, label: 'Capability areas', detail: 'From bots to infrastructure' }
];
---

<KruigerLayout title={SITE.title} description={SITE.description}>
    <!-- ============================ HERO ============================ -->
    <section class="hero">
        <BackgroundGrid orbs beam particles />
        <Container class="hero__inner">
            <span class="kl-eyebrow" data-reveal>Kruiger Labs LLC</span>

            <h1 class="hero__title" data-reveal>
                <span class="hero__kicker kl-metal">Developed by</span>
                <span class="hero__brand">
                    <span class="kl-metal">Kruiger</span>
                    <span class="kl-violet">Labs</span>
                </span>
            </h1>

            <p class="kl-lead hero__lead" data-reveal>
                Premium software, infrastructure, hosting, automation, Discord systems, FiveM development, and digital
                solutions built for modern communities and businesses.
            </p>

            <div class="hero__actions" data-reveal>
                <Button href="/products" size="lg">Explore Products</Button>
                <Button href="/docs" variant="secondary" size="lg">Documentation</Button>
            </div>

            <a class="kl-link hero__more" href="/about">Learn about Kruiger Labs</a>

            <ul class="hero__icons" data-reveal>
                {
                    heroIcons.map((item) => (
                        <li>
                            <span class="hero__icon">
                                <Icon name={item.icon} size={22} />
                            </span>
                            <span>{item.label}</span>
                        </li>
                    ))
                }
            </ul>
        </Container>
        <hr class="kl-divider" />
    </section>

    <!-- ========================= WHAT WE BUILD ======================== -->
    <section class="kl-section" id="what-we-build">
        <Container>
            <SectionHeader
                eyebrow="Capabilities"
                title="What We"
                accent="Build"
                description="Seven areas of engineering, delivered as products or as bespoke work for your community or business."
            />
            <div class="kl-grid kl-grid--3">
                {
                    SERVICES.map((service, index) => (
                        <ServiceCard
                            title={service.title}
                            description={service.description}
                            icon={service.icon}
                            href={`/services#${service.slug}`}
                            delay={(index % 3) * 70}
                        />
                    ))
                }
            </div>
        </Container>
    </section>

    <!-- =========================== PRODUCTS ========================== -->
    <section class="kl-section" id="products">
        <Container>
            <SectionHeader
                eyebrow="Catalogue"
                title="Kruiger Labs"
                accent="Products"
                description="Live products, integrations, and development services. Filter by the kind of system you need."
            />
            <ProductGrid products={products} />
            <div class="section-cta">
                <Button href="/products" variant="secondary">View Full Catalogue</Button>
            </div>
        </Container>
    </section>

    <!-- =========================== CLOUDNORD ========================= -->
    <section class="kl-section cloudnord" id="cloudnord">
        <BackgroundGrid orbs />
        <Container>
            <SectionHeader eyebrow="CloudNord" title="Powered for" accent="Performance" description={CLOUDNORD.subheadline} />
            <div class="kl-grid kl-grid--3">
                {
                    CLOUDNORD.categories.map((category, index) => (
                        <Card interactive brackets reveal delay={(index % 3) * 70}>
                            <span class="kl-card__icon">
                                <Icon name={category.icon} />
                            </span>
                            <h3>{category.title}</h3>
                            <p>{category.description}</p>
                        </Card>
                    ))
                }
            </div>
            <div class="section-cta">
                <Button href="/cloudnord" size="lg">Explore CloudNord</Button>
            </div>
        </Container>
    </section>

    <!-- ============================ STATS =========================== -->
    <section class="kl-section" id="platform">
        <Container>
            <div class="stats" data-reveal>
                {
                    stats.map((stat) => (
                        <div class="stat">
                            <span class="stat__value kl-metal" data-count-to={stat.value}>
                                {stat.value}
                            </span>
                            <span class="stat__label">{stat.label}</span>
                            <span class="stat__detail">{stat.detail}</span>
                        </div>
                    ))
                }
            </div>
            <p class="stats__note">Figures are counted directly from the live product catalogue and documentation index.</p>
        </Container>
    </section>

    <!-- ======================== WHY KRUIGER LABS ===================== -->
    <section class="kl-section" id="why">
        <Container>
            <SectionHeader
                eyebrow="Why us"
                title="Why"
                accent="Kruiger Labs"
                description="How the systems are built, and what that means for the people running them."
            />
            <div class="kl-grid kl-grid--3">
                {
                    WHY.map((item, index) => (
                        <Card interactive reveal delay={(index % 3) * 70}>
                            <span class="kl-card__icon">
                                <Icon name={item.icon} />
                            </span>
                            <h3>{item.title}</h3>
                            <p>{item.description}</p>
                        </Card>
                    ))
                }
            </div>
        </Container>
    </section>

    <!-- ========================== TECHNOLOGY ========================= -->
    <section class="kl-section" id="technology">
        <Container>
            <SectionHeader
                eyebrow="Stack"
                title="Built With Modern"
                accent="Technology"
                description="The tooling actually running behind Kruiger Labs products and infrastructure."
            />
            <ul class="tech" data-reveal>
                {
                    TECHNOLOGIES.map((technology) => (
                        <li>
                            <Badge>{technology}</Badge>
                        </li>
                    ))
                }
            </ul>
        </Container>
    </section>

    <!-- ============================= CTA ============================ -->
    <section class="kl-section" id="start">
        <Container size="narrow">
            <GlowPanel class="cta" reveal>
                <h2 class="kl-display cta__title">
                    <span class="kl-metal">Build Something</span>
                    <span class="kl-violet"> Better.</span>
                </h2>
                <p class="kl-lead">
                    From Discord automation to complete infrastructure platforms, Kruiger Labs builds systems designed
                    around your community or business.
                </p>
                <div class="cta__actions">
                    <Button href="/contact" size="lg">Start a Project</Button>
                    <Button href="/products" variant="secondary" size="lg">View Products</Button>
                </div>
            </GlowPanel>
        </Container>
    </section>
</KruigerLayout>

<style>
    /* ---------------------------- Hero ---------------------------- */
    .hero {
        position: relative;
        padding-block: clamp(96px, 15vh, 168px) clamp(52px, 8vw, 96px);
        margin-top: var(--kl-nav-h);
        text-align: center;
    }

    .hero :global(.hero__inner) {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
    }

    .hero__title {
        display: flex;
        flex-direction: column;
        gap: 4px;
        margin: 0;
        font-family: var(--kl-font-display);
        text-transform: uppercase;
        line-height: 1.02;
    }

    .hero__kicker {
        font-size: clamp(0.95rem, 2.4vw, 1.4rem);
        font-weight: 500;
        letter-spacing: 0.42em;
        /* Optical centring: the wide tracking adds a trailing gap. */
        text-indent: 0.42em;
    }

    .hero__brand {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.25em;
        font-size: clamp(2.6rem, 9vw, 6rem);
        font-weight: 900;
        letter-spacing: 0.02em;
    }

    .hero__lead {
        max-width: 66ch;
    }

    .hero__actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 14px;
        margin-top: 6px;
    }

    .hero__more {
        font-size: 0.84rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .hero__icons {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: clamp(14px, 3vw, 34px);
        margin: clamp(22px, 4vw, 42px) 0 0;
        padding: 0;
        list-style: none;
    }

    .hero__icons li {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 9px;
        color: var(--kl-silver-muted);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .hero__icon {
        display: grid;
        place-items: center;
        width: 52px;
        height: 52px;
        color: var(--kl-purple-bright);
        background: rgba(18, 18, 25, 0.72);
        border: 1px solid var(--kl-border);
        /* Hexagon-adjacent chamfer, echoing the brand's panel language. */
        clip-path: polygon(24% 0, 76% 0, 100% 50%, 76% 100%, 24% 100%, 0 50%);
        transition:
            color var(--kl-t),
            background-color var(--kl-t);
    }

    .hero__icons li:hover .hero__icon {
        color: var(--kl-white);
        background: rgba(139, 92, 246, 0.22);
    }

    /* -------------------------- Sections -------------------------- */
    .section-cta {
        display: flex;
        justify-content: center;
        margin-top: clamp(28px, 4vw, 44px);
    }

    .cloudnord {
        position: relative;
        overflow: hidden;
    }

    /* --------------------------- Stats ---------------------------- */
    .stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1px;
        background: var(--kl-border);
        border: 1px solid var(--kl-border);
        border-radius: var(--kl-r-lg);
        overflow: hidden;
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: clamp(22px, 3vw, 34px) clamp(16px, 2vw, 26px);
        background: rgba(15, 15, 22, 0.86);
        text-align: center;
    }

    .stat__value {
        font-family: var(--kl-font-display);
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 900;
        line-height: 1;
    }

    .stat__label {
        color: var(--kl-silver);
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .stat__detail {
        color: var(--kl-text-muted);
        font-size: 0.8rem;
    }

    .stats__note {
        margin: 16px 0 0;
        color: var(--kl-silver-muted);
        font-size: 0.78rem;
        text-align: center;
    }

    /* ----------------------- Technology list ---------------------- */
    .tech {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    /* ----------------------------- CTA ---------------------------- */
    .cta {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 18px;
        padding: clamp(32px, 6vw, 62px) clamp(22px, 5vw, 56px);
        text-align: center;
    }

    .cta__title {
        margin: 0;
        font-size: clamp(1.9rem, 5.4vw, 3.2rem);
        text-transform: uppercase;
    }

    .cta__actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 14px;
        margin-top: 6px;
    }

    /* -------------------------- Breakpoints ----------------------- */
    @media (max-width: 860px) {
        .stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 520px) {
        .hero {
            padding-top: clamp(72px, 12vh, 110px);
        }

        .hero__kicker {
            letter-spacing: 0.3em;
            text-indent: 0.3em;
        }

        .hero__actions :global(.kl-btn) {
            width: 100%;
        }

        .hero__icons {
            gap: 14px;
        }
    }
</style>
