---
import KruigerLayout from '../layouts/KruigerLayout.astro';
---

<KruigerLayout title="KruigerLabs">

  <!-- NAVBAR -->
  <header class="navbar">
    <div class="logo">KRUIGER<span>LABS</span></div>

    <nav>
      <a href="#home">Home</a>
      <a href="#about">About Us</a>
      <a href="#bots">Our Bots</a>
    </nav>

    <a href="http://kruigerlabs.discord.kruigerlabs.xyz/" class="btn-glow" target="_blank" rel="noopener noreferrer">JOIN OUR DISCORD</a>
  </header>


  <!-- HERO SECTION -->
  <section class="hero" id="home">
    <div class="hero-content">

      <img src="/assets/logo.png" class="hero-logo" alt="KruigerLabs Logo">

      <h1>KRUIGER<span>LABS</span></h1>

      <p>
        Empowering your enterprise with cutting-edge AI development,
        automation, and futuristic digital systems.
      </p>

      <a href="https://discord.kruigerlabs.xyz" class="btn-glow big" target="_blank" rel="noopener noreferrer">JOIN OUR DISCORD</a>

    </div>
  </section>


  <!-- ABOUT US SECTION -->
  <section class="about" id="about">
    <h3>ABOUT <span>KRUIGERLABS</span></h3>

    <div class="about-content">
      <p class="about-intro">
        Welcome to KruigerLabs — you probably found us through Discord or the TazElite Plays community.
      </p>
      <p class="about-description">
        We specialize in building advanced Discord bots, Twitch integrations, and automation tools designed to power modern communities. From moderation systems to AI-driven features and custom dashboards, KruigerLabs is focused on pushing boundaries and creating futuristic digital solutions.
      </p>
      <p class="about-tagline">Welcome to the lab.</p>
    </div>

    <!-- Skills Section -->
    <div class="skills-section">
      <h4 class="skills-heading">Skills</h4>
