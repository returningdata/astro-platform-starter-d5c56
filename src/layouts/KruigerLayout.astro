---
import '@fontsource-variable/inter/wght.css';
import '../styles/kruiger.css';

import Navbar from '../components/kl/Navbar.astro';
import SiteFooter from '../components/kl/SiteFooter.astro';
import ChatbotWidget from '../components/ChatbotWidget.tsx';
import { SITE } from '../data/site';

/**
 * Public site shell. Props stay backwards compatible with the previous layout
 * (`title`, `description`) so existing pages keep working unchanged.
 */
interface Props {
    title?: string;
    description?: string;
    /** Absolute or root-relative social share image. */
    image?: string;
    /** Set false for pages that render their own header/footer chrome. */
    chrome?: boolean;
    /** Keeps a page out of search results. */
    noindex?: boolean;
    bodyClass?: string;
}

const {
    title = SITE.title,
    description = SITE.description,
    image = SITE.ogImage,
    chrome = true,
    noindex = false,
    bodyClass = ''
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const socialImage = new URL(image, SITE.url).href;

const organisation = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    alternateName: SITE.shortName,
    url: SITE.url,
    logo: new URL('/assets/logo.png', SITE.url).href,
    description: SITE.description,
    sameAs: [SITE.discord]
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />

        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        {noindex && <meta name="robots" content="noindex, nofollow" />}

        <link rel="icon" type="image/png" href="/favicon.png" />
        <meta name="theme-color" content="#07070A" />
        <meta name="color-scheme" content="dark" />

        <!-- Display face for headings; body text uses the bundled Inter Variable. -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&display=swap"
        />

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={SITE.name} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={socialImage} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImage} />

        <script type="application/ld+json" set:html={JSON.stringify(organisation)} />
    </head>

    <body class={bodyClass}>
        <div class="kl-backdrop" aria-hidden="true"></div>

        {chrome && <Navbar />}

        <main id="main">
            <slot />
        </main>

        {chrome && <SiteFooter />}

        <ChatbotWidget client:load />

        <script>
            // Scroll reveal: elements marked [data-reveal] fade up once visible.
            const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            if (reduceMotion || !('IntersectionObserver' in window)) {
                revealables.forEach((element) => element.classList.add('is-revealed'));
            } else {
                const observer = new IntersectionObserver(
                    (entries) => {
                        entries.forEach((entry) => {
                            if (!entry.isIntersecting) return;
                            entry.target.classList.add('is-revealed');
                            observer.unobserve(entry.target);
                        });
                    },
                    { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
                );
                revealables.forEach((element) => observer.observe(element));
            }

            // Count-up for real figures only — the markup supplies the number.
            document.querySelectorAll<HTMLElement>('[data-count-to]').forEach((element) => {
                const target = Number(element.dataset.countTo || '0');
                if (!target || reduceMotion) {
                    element.textContent = String(target);
                    return;
                }

                const run = () => {
                    const duration = 1100;
                    const start = performance.now();
                    const step = (now: number) => {
                        const progress = Math.min((now - start) / duration, 1);
                        // Ease-out so the number settles rather than stopping abruptly.
                        const eased = 1 - Math.pow(1 - progress, 3);
                        element.textContent = String(Math.round(target * eased));
                        if (progress < 1) requestAnimationFrame(step);
                    };
                    requestAnimationFrame(step);
                };

                const counter = new IntersectionObserver((entries) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) return;
                        run();
                        counter.unobserve(entry.target);
                    });
                });
                counter.observe(element);
            });

            // Ambient particles. Deliberately sparse so mobile GPUs stay cool.
            document.querySelectorAll<HTMLCanvasElement>('canvas[data-kl-particles]').forEach((canvas) => {
                if (reduceMotion) {
                    canvas.remove();
                    return;
                }

                const context = canvas.getContext('2d');
                if (!context) return;

                const density = window.innerWidth < 720 ? 16 : 32;
                let particles: { x: number; y: number; r: number; vx: number; vy: number; a: number }[] = [];
                let frame = 0;

                const seed = () => {
                    const { width, height } = canvas.getBoundingClientRect();
                    const ratio = Math.min(window.devicePixelRatio || 1, 2);
                    canvas.width = Math.max(1, Math.floor(width * ratio));
                    canvas.height = Math.max(1, Math.floor(height * ratio));
                    context.setTransform(ratio, 0, 0, ratio, 0, 0);
                    particles = Array.from({ length: density }, () => ({
                        x: Math.random() * width,
                        y: Math.random() * height,
                        r: Math.random() * 1.5 + 0.4,
                        vx: (Math.random() - 0.5) * 0.12,
                        vy: -(Math.random() * 0.18 + 0.04),
                        a: Math.random() * 0.35 + 0.12
                    }));
                };

                const draw = () => {
                    const { width, height } = canvas.getBoundingClientRect();
                    context.clearRect(0, 0, width, height);
                    for (const particle of particles) {
                        particle.x += particle.vx;
                        particle.y += particle.vy;
                        if (particle.y < -6) {
                            particle.y = height + 6;
                            particle.x = Math.random() * width;
                        }
                        if (particle.x < -6) particle.x = width + 6;
                        if (particle.x > width + 6) particle.x = -6;

                        context.beginPath();
                        context.arc(particle.x, particle.y, particle.r, 0, Math.PI * 2);
                        context.fillStyle = `rgba(168, 85, 247, ${particle.a})`;
                        context.fill();
                    }
                    frame = requestAnimationFrame(draw);
                };

                seed();

                // Only animate while the canvas is on screen.
                const visibility = new IntersectionObserver((entries) => {
                    entries.forEach((entry) => {
                        cancelAnimationFrame(frame);
                        if (entry.isIntersecting) draw();
                    });
                });
                visibility.observe(canvas);

                let resizeTimer = 0;
                window.addEventListener('resize', () => {
                    window.clearTimeout(resizeTimer);
                    resizeTimer = window.setTimeout(seed, 180);
                });
            });
        </script>
    </body>
</html>
