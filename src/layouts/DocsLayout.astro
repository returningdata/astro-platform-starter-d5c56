---
import '../styles/docs.css';
import DocsBar from '../components/DocsBar.astro';
import DocsFooterBar from '../components/DocsFooterBar.astro';
import { docsNavigation, docsSearchEntries, type DocArticle } from '../data/docs';

interface Props {
  title: string;
  description?: string;
  activePath?: string;
  toc?: { id: string; label: string }[];
  previous?: DocArticle;
  next?: DocArticle;
  product?: string;
}
const { title, description = 'Kruiger Labs LLC product documentation and support.', activePath = '', toc = [], previous, next, product } = Astro.props;
const path = Astro.url.pathname;
const crumbParts = activePath.split('/').filter(Boolean);
const hrefFor = (docPath: string) => `/docs/${docPath}${docPath ? '/' : ''}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} | Kruiger Labs LLC Docs</title>
  <link rel="icon" href="/favicon.png" />
  <meta name="theme-color" content="#07070A" />
  <meta name="color-scheme" content="dark" />
</head>
<body>
  <DocsBar active="Documentation" />
  <div class="docs-top">
    <div class="docs-title-wrap"><button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle documentation navigation" aria-expanded="false">Menu</button><div class="docs-title">Documentation<small>{product || 'Kruiger Labs products'}</small></div></div>
    <button class="search-button" id="search-open"><span>Search products, guides, commands, and settings…</span><span class="kbd">Ctrl K</span></button>
    <div class="top-actions"><a class="button-secondary" href="/api/auth/discord?action=login&returnTo=/customer">Sign in</a><a class="button" href="/support">Get support</a></div>
  </div>
  <div class="docs-grid">
    <aside class="docs-sidebar" id="docs-sidebar" aria-label="Documentation navigation">
      {docsNavigation.map(group => <details open={group.label === 'Documentation' || group.links.some(([, itemPath]) => itemPath === activePath)}><summary>{group.label}</summary><nav>{group.links.map(([label, itemPath]) => <a class={itemPath === activePath ? 'active' : ''} aria-current={itemPath === activePath ? 'page' : undefined} href={hrefFor(itemPath)}>{label}</a>)}</nav></details>)}
    </aside>
    <main class="docs-content" id="main-content">
      <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/docs/">Docs</a>{crumbParts.length > 1 && <><span>›</span><a href={`/docs/${crumbParts[0]}/`}>{product || crumbParts[0]}</a></>} {activePath && <><span>›</span><span>{title}</span></>}</nav>
      <slot />
      <div class="article-footer"><span>Maintained documentation · Current buyer release</span><div class="helpful">Was this helpful? <button data-helpful="true">Yes</button> <button data-helpful="false">No</button></div></div>
      <nav class="pager" aria-label="Previous and next articles">{previous ? <a href={hrefFor(previous.path)}>← <span>{previous.title}</span></a> : <a href="/docs/">← Documentation home</a>}{next ? <a href={hrefFor(next.path)}><span>{next.title}</span> →</a> : <a href="/support"><span>Support centre</span> →</a>}</nav>
      <p class="back-top"><a href="#main-content">Back to top</a></p>
    </main>
    <aside class="docs-toc"><strong>On this page</strong>{toc.map(item => <a href={`#${item.id}`}>{item.label}</a>)}</aside>
  </div>
  <DocsFooterBar />
  <div class="search-modal" id="search-modal" role="dialog" aria-modal="true" aria-label="Search documentation"><div class="search-shell"><div class="search-modal-head"><strong>Search documentation</strong><button id="search-close" aria-label="Close search">Close</button></div><input class="search-input" id="global-search" placeholder="Try “Scarlett allowedGuilds” or “IAA nonce”" autocomplete="off" /><div class="search-results" id="search-results"></div></div></div>
  <script define:vars={{ searchEntries: docsSearchEntries }}>
    const modal=document.querySelector('#search-modal');const input=document.querySelector('#global-search');const results=document.querySelector('#search-results');const openButton=document.querySelector('#search-open');const closeButton=document.querySelector('#search-close');
    const escapeHtml=(value)=>String(value).replace(/[&<>'"]/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
    const render=async()=>{const q=input.value.toLowerCase().trim();const terms=q.split(/\s+/).filter(Boolean);let ranked=searchEntries.map(item=>{const hay=`${item.title} ${item.excerpt} ${item.category} ${item.keywords}`.toLowerCase();return{...item,score:terms.reduce((score,term)=>score+(hay.includes(term)?3:0)+(item.title.toLowerCase().includes(term)?2:0),0)}}).filter(item=>!terms.length||item.score>0).sort((a,b)=>b.score-a.score).slice(0,16);if(q.length>1){const dynamic=await fetch(`/api/docs/content?resource=search&q=${encodeURIComponent(q)}`).then(response=>response.ok?response.json():({items:[]})).catch(()=>({items:[]}));ranked=[...ranked,...(dynamic.items||[])].filter((item,index,all)=>all.findIndex(candidate=>candidate.href===item.href)===index).slice(0,16)}results.innerHTML=ranked.map(item=>`<a class="search-result" href="${escapeHtml(item.href)}"><strong>${escapeHtml(item.title)}</strong><span>${escapeHtml(item.category)} — ${escapeHtml(item.excerpt.slice(0,165))}</span></a>`).join('')||'<div class="search-result"><span>No matching documentation found.</span></div>'};
    const open=()=>{modal.classList.add('open');input.focus();render()};const close=()=>modal.classList.remove('open');openButton?.addEventListener('click',open);closeButton?.addEventListener('click',close);modal.addEventListener('click',event=>{if(event.target===modal)close()});input.addEventListener('input',render);document.addEventListener('keydown',event=>{if((event.metaKey||event.ctrlKey)&&event.key.toLowerCase()==='k'){event.preventDefault();open()}if(event.key==='Escape')close()});
    const mobileButton=document.querySelector('#mobile-toggle');const sidebar=document.querySelector('#docs-sidebar');mobileButton?.addEventListener('click',()=>{const isOpen=sidebar.classList.toggle('open');mobileButton.setAttribute('aria-expanded',String(isOpen))});sidebar?.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>sidebar.classList.remove('open')));
    document.querySelectorAll('[data-helpful]').forEach(button=>button.addEventListener('click',async()=>{await fetch('/api/docs/feedback',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({articleSlug:location.pathname,helpful:button.dataset.helpful==='true'})}).catch(()=>null);button.parentElement.textContent='Thanks for your feedback.'}));
  </script>
  <script>
    for (const block of document.querySelectorAll<HTMLElement>('.docs-content pre.code')) { if (block.parentElement?.querySelector('.code-copy')) continue; const button=document.createElement('button');button.type='button';button.className='code-copy';button.textContent='Copy';button.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(block.textContent?.trim()??'');button.textContent='Copied'}catch{button.textContent='Press Ctrl+C'}window.setTimeout(()=>button.textContent='Copy',1800)});block.parentElement?.append(button); }
  </script>
</body>
</html>
